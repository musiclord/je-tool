{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "儲存篩選情境：呼叫順序",
    "locale": "zh-TW",
    "output": "archify/action-sequence/action-sequence.html",
    "quality_profile": "showcase",
    "legend": {
      "mode": "auto",
      "entries": {
        "default": {
          "label": "直接呼叫"
        },
        "dashed": {
          "label": "介面呼叫"
        },
        "emphasis": {
          "label": "間接觸發"
        },
        "return": {
          "label": "回傳"
        }
      }
    },
    "visual_preset": "editorial"
  },
  "participants": [
    {
      "id": "ui",
      "type": "frontend",
      "label": "第五步畫面",
      "sublabel": "JetApi"
    },
    {
      "id": "bridge",
      "type": "backend",
      "label": "接收畫面訊息",
      "sublabel": "JetWebMessageBridge"
    },
    {
      "id": "dispatcher",
      "type": "backend",
      "label": "找到處理類別",
      "sublabel": "ActionDispatcher"
    },
    {
      "id": "handler",
      "type": "backend",
      "label": "情境儲存處理",
      "sublabel": "FilterScenarioSaveHandler"
    },
    {
      "id": "batch",
      "type": "backend",
      "label": "整批規劃與發布",
      "sublabel": "FilterScenarioBatchWriter"
    },
    {
      "id": "facts",
      "type": "backend",
      "label": "篩選執行",
      "sublabel": "FilterFactsPort"
    },
    {
      "id": "db",
      "type": "database",
      "label": "案件資料庫",
      "sublabel": "SQLite 或 DuckDB"
    }
  ],
  "segments": [
    {
      "from": 150,
      "to": 320,
      "label": "共用分派：每個 action 都經過"
    },
    {
      "from": 352,
      "to": 770,
      "label": "讀取與檢查：不符時回錯誤，不寫入"
    },
    {
      "from": 784,
      "to": 1042,
      "label": "分支 A：只存這一個情境"
    },
    {
      "from": 1056,
      "to": 1306,
      "label": "分支 B：整批處理，全部合格"
    },
    {
      "from": 1320,
      "to": 1446,
      "label": "分支 C：整批處理，仍有不合格"
    },
    {
      "from": 1460,
      "to": 1692,
      "label": "提交之後：不再接受取消"
    }
  ],
  "messages": [
    {
      "id": "m01",
      "from": "ui",
      "to": "bridge",
      "y": 180,
      "label": "filter.scenario.save",
      "variant": "emphasis"
    },
    {
      "id": "m02",
      "from": "bridge",
      "to": "dispatcher",
      "y": 224,
      "label": "DispatchAsync",
      "note": "畫面可以取消"
    },
    {
      "id": "m03",
      "from": "dispatcher",
      "to": "handler",
      "y": 286,
      "label": "IApplicationActionHandler.HandleAsync",
      "variant": "dashed",
      "note": "依 action 名稱找處理類別"
    },
    {
      "id": "m04",
      "from": "handler",
      "to": "batch",
      "y": 382,
      "label": "LoadAsync",
      "note": "需要目前的驗證結果與 GL 配對"
    },
    {
      "id": "m05",
      "from": "handler",
      "to": "db",
      "y": 444,
      "label": "IFilterScenarioStore.ListAsync",
      "variant": "dashed",
      "note": "讀出已存情境，照原樣保留"
    },
    {
      "id": "m06",
      "from": "db",
      "to": "handler",
      "y": 506,
      "label": "已存情境",
      "variant": "return"
    },
    {
      "id": "m07",
      "from": "handler",
      "to": "batch",
      "y": 550,
      "label": "PlanSave",
      "note": "只檢查本次情境的上限、位置、名稱與規則"
    },
    {
      "id": "m08",
      "from": "handler",
      "to": "batch",
      "y": 612,
      "label": "PublishAsync",
      "note": "PlanWrite 決定走哪一支"
    },
    {
      "id": "m19",
      "from": "batch",
      "to": "db",
      "label": "IResultStaleStateStore.ReadAsync",
      "variant": "dashed",
      "note": "存好的篩選結果有沒有過期",
      "y": 674
    },
    {
      "id": "m20",
      "from": "db",
      "to": "batch",
      "label": "失效狀態",
      "variant": "return",
      "y": 736
    },
    {
      "id": "m21",
      "from": "batch",
      "to": "facts",
      "label": "IFilterFactsPort.ExecuteAsync",
      "variant": "dashed",
      "note": "由 JetAuditProgram.PlanOneScenario 建立計畫",
      "y": 814
    },
    {
      "id": "m22",
      "from": "facts",
      "to": "db",
      "label": "IFilterCommitRepository.SaveOneAsync",
      "variant": "dashed",
      "note": "同一筆交易只換這個情境的定義與命中",
      "y": 884
    },
    {
      "id": "m23",
      "from": "db",
      "to": "facts",
      "label": "已提交",
      "variant": "return",
      "note": "提交前檢查取消",
      "y": 946
    },
    {
      "id": "m24",
      "from": "facts",
      "to": "batch",
      "label": "FilterFacts",
      "variant": "return",
      "y": 1008
    },
    {
      "id": "m09",
      "from": "batch",
      "to": "facts",
      "y": 1086,
      "label": "IFilterFactsPort.ExecuteAsync",
      "variant": "dashed",
      "note": "先由 JetAuditProgram 建立整批的計畫"
    },
    {
      "id": "m10",
      "from": "facts",
      "to": "db",
      "y": 1148,
      "label": "IFilterCommitRepository.CommitAsync",
      "variant": "dashed",
      "note": "同一筆交易取代定義，用 SQL 算出命中"
    },
    {
      "id": "m11",
      "from": "db",
      "to": "facts",
      "y": 1210,
      "label": "已提交",
      "variant": "return",
      "note": "提交前檢查取消"
    },
    {
      "id": "m12",
      "from": "facts",
      "to": "batch",
      "y": 1272,
      "label": "FilterFacts",
      "variant": "return"
    },
    {
      "id": "m13",
      "from": "batch",
      "to": "db",
      "y": 1350,
      "label": "IFilterScenarioStore.ReplaceAllAsync",
      "variant": "dashed",
      "note": "同一筆交易只寫定義、清除命中並標成失效"
    },
    {
      "id": "m14",
      "from": "db",
      "to": "batch",
      "y": 1412,
      "label": "已提交",
      "variant": "return"
    },
    {
      "id": "m15",
      "from": "batch",
      "to": "handler",
      "y": 1490,
      "label": "情境、命中版本與失效狀態",
      "variant": "return",
      "note": "有存下結果時先推進步驟，再讀回資料庫的最新狀態"
    },
    {
      "id": "m16",
      "from": "handler",
      "to": "dispatcher",
      "y": 1552,
      "label": "回應",
      "variant": "return"
    },
    {
      "id": "m17",
      "from": "dispatcher",
      "to": "bridge",
      "y": 1596,
      "label": "回應",
      "variant": "return",
      "note": "例外改回固定錯誤碼；已取消時一律回報成取消"
    },
    {
      "id": "m18",
      "from": "bridge",
      "to": "ui",
      "y": 1658,
      "label": "PostWebMessageAsJson",
      "variant": "return",
      "note": "依 requestId 把結果交回畫面"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "這張圖怎麼讀",
      "items": [
        "第五步按下儲存後，JET 先檢查案件、目前驗證結果與 GL 配對。",
        "其他情境合格且結果未過期時，只存本次情境；否則整批處理。"
      ]
    },
    {
      "dot": "amber",
      "title": "三種儲存結果",
      "items": [
        "A 只換本次情境。B 全部合格，重算並儲存全部結果。C 仍有情境待修，只存定義並清除命中。",
        "前提不符、本次情境不合格或提交前取消時不寫入。步驟更新失敗會記錄日誌，已存情境仍保留。"
      ]
    }
  ],
