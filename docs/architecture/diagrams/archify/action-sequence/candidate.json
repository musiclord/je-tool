  "cards": [
    {
      "dot": "cyan",
      "title": "這張圖怎麼讀",
      "items": [
        "第五步按下儲存後，JET 先檢查案件、目前驗證結果與 GL 配對。",
        "其他情境合格且結果未過期時，只存本次情境；否則整批處理。"
      ]
    },
    {
      "dot": "slate",
      "title": "參與者與程式類別",
      "items": [
        "第五步畫面：JetApi。",
        "接收畫面訊息：JetWebMessageBridge。",
        "找到處理類別：ActionDispatcher。",
        "情境儲存處理：FilterScenarioSaveHandler。",
        "整批規劃與發布：FilterScenarioBatchWriter。",
        "篩選執行：FilterFactsPort。",
        "案件資料庫：SQLite。"
      ]
    },
    {
      "dot": "slate",
      "title": "共用分派",
      "items": [
        "DispatchAsync：畫面可以取消。",
        "IApplicationActionHandler.HandleAsync：依 action 名稱找處理類別。"
      ]
    },
    {
      "dot": "slate",
      "title": "讀取與檢查",
      "items": [
        "LoadAsync：需要目前的驗證結果與 GL 配對。",
        "IFilterScenarioStore.ListAsync：讀出已存情境，照原樣保留。",
        "PlanSave：只檢查本次情境的上限、位置、名稱與規則。",
        "PublishAsync：先讀失效狀態，再由 PlanWrite 決定走哪一支。",
        "IResultStaleStateStore.ReadAsync：讀出存好的篩選結果有沒有過期。"
      ]
    },
    {
      "dot": "slate",
      "title": "分支 A：只存這一個情境",
      "items": [
        "IFilterFactsPort.ExecuteAsync：由 JetAuditProgram.PlanOneScenario 建立計畫。",
        "IFilterCommitRepository.SaveOneAsync：同一筆交易只換這個情境的定義與命中。",
        "已提交：提交前會檢查是否已取消。"
      ]
    },
    {
      "dot": "slate",
      "title": "分支 B：整批處理，全部合格",
      "items": [
        "IFilterFactsPort.ExecuteAsync：先由 JetAuditProgram 建立整批的計畫。",
        "IFilterCommitRepository.CommitAsync：同一筆交易取代定義，用 SQL 算出命中。",
        "已提交：提交前會檢查是否已取消。"
      ]
    },
    {
      "dot": "slate",
      "title": "分支 C：整批處理，仍有不合格",
      "items": [
        "IFilterScenarioStore.ReplaceAllAsync：同一筆交易只寫定義、清除命中並標成失效。"
      ]
    },
    {
      "dot": "slate",
      "title": "提交之後",
      "items": [
        "情境、命中版本與失效狀態：有存下結果時先推進步驟，再讀回資料庫的最新狀態。",
        "找到處理類別交回的回應：例外改回固定錯誤碼；已取消時一律回報成取消。",
        "PostWebMessageAsJson：依 requestId 把結果交回畫面。"
      ]
    },
    {
      "dot": "amber",
      "title": "三種儲存結果",
      "items": [
        "A 只換本次情境。B 全部合格，重算並儲存全部結果。C 仍有情境待修，只存定義並清除命中。",
        "前提不符、本次情境不合格或提交前取消時不寫入。步驟更新失敗會記錄日誌，已存情境仍保留。"
      ]
    }
  ],
