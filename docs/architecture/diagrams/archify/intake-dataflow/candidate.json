{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "來源檔如何成為審計資料",
    "locale": "zh-TW",
    "output": "archify/intake-dataflow/intake-dataflow.html",
    "quality_profile": "showcase",
    "legend": {
      "mode": "auto",
      "entries": {
        "default": {
          "label": "JET 逐列讀取，分批寫入"
        },
        "dashed": {
          "label": "只傳操作參數，不含資料列"
        }
      }
    },
    "visual_preset": "editorial"
  },
  "stages": [
    {
      "label": "來源檔案"
    },
    {
      "label": "匯入：逐列讀取"
    },
    {
      "label": "原始資料表"
    },
    {
      "label": "確認配對：轉成標準格式"
    },
    {
      "label": "標準化資料表"
    }
  ],
  "nodes": [
    {
      "id": "glfile",
      "type": "external",
      "stage": 0,
      "row": 0,
      "label": "總帳檔案",
      "sublabel": "xlsx、xls、CSV 或 Access"
    },
    {
      "id": "tbfile",
      "type": "external",
      "stage": 0,
      "row": 2,
      "label": "試算表檔案",
      "sublabel": "xlsx、xls、CSV 或 Access"
    },
    {
      "id": "glread",
      "type": "backend",
      "stage": 1,
      "row": 0,
      "label": "讀取 GL",
      "sublabel": "import.gl.fromFile"
    },
    {
      "id": "tbread",
      "type": "backend",
      "stage": 1,
      "row": 2,
      "label": "讀取 TB",
      "sublabel": "import.tb.fromFile"
    },
    {
      "id": "glraw",
      "type": "database",
      "stage": 2,
      "row": 0,
      "label": "PBC-GL",
      "sublabel": "pbc_gl"
    },
    {
      "id": "auditor",
      "type": "frontend",
      "stage": 3,
      "row": 1,
      "label": "審計員確認配對",
      "sublabel": "第三步"
    },
    {
      "id": "tbraw",
      "type": "database",
      "stage": 2,
      "row": 2,
      "label": "PBC-TB",
      "sublabel": "pbc_tb"
    },
    {
      "id": "glmap",
      "type": "backend",
      "stage": 3,
      "row": 0,
      "label": "產生標準 GL",
      "sublabel": "mapping.commit.gl"
    },
    {
      "id": "tbmap",
      "type": "backend",
      "stage": 3,
      "row": 2,
      "label": "產生標準 TB",
      "sublabel": "mapping.commit.tb"
    },
    {
      "id": "gl",
      "type": "database",
      "stage": 4,
      "row": 0,
      "label": "GL",
      "sublabel": "gl"
    },
    {
      "id": "tb",
      "type": "database",
      "stage": 4,
      "row": 2,
      "label": "TB",
      "sublabel": "tb"
    }
  ],
  "flows": [
    {
      "id": "gl_read",
      "from": "glfile",
      "to": "glread",
      "label": "來源列"
    },
    {
      "id": "gl_stage",
      "from": "glread",
      "to": "glraw",
      "label": "原始列 JSON"
    },
    {
      "id": "gl_back",
      "from": "glraw",
      "to": "glmap",
      "label": "逐列讀回"
    },
    {
      "id": "gl_target",
      "from": "glmap",
      "to": "gl",
      "label": "標準分錄"
    },
    {
      "id": "tb_read",
      "from": "tbfile",
      "to": "tbread",
      "label": "來源列"
    },
    {
      "id": "tb_stage",
      "from": "tbread",
      "to": "tbraw",
      "label": "原始列 JSON"
    },
    {
      "id": "tb_back",
      "from": "tbraw",
      "to": "tbmap",
      "label": "逐列讀回"
    },
    {
      "id": "tb_target",
      "from": "tbmap",
      "to": "tb",
      "label": "標準餘額"
    },
    {
      "id": "gl_mapping",
      "from": "auditor",
      "to": "glmap",
      "label": "GL 欄位配對",
      "variant": "dashed"
    },
    {
      "id": "tb_mapping",
      "from": "auditor",
      "to": "tbmap",
      "label": "TB 欄位配對",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "匯入與配對分開進行",
      "items": [
        "匯入先儲存原始資料；審計員確認欄位配對後，才轉成標準 GL 與 TB。兩次操作各用一筆交易。",
        "畫面只傳檔案與配對設定，資料列由後端處理。"
      ]
    },
    {
      "dot": "slate",
      "title": "重新匯入後",
      "items": [
        "舊的標準化資料會清除，原配對移到上一版。重新確認配對後再產生標準化資料。",
        "GL 也保存未納入測試的分錄；查核期間與過帳狀態決定測試母體。"
      ]
    }
  ]
}
