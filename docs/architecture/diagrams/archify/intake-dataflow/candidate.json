    {
      "label": "原始資料表"
    },
    {
      "label": "確認配對：轉成標準格式"
    },
    {
      "label": "標準化資料表"
    }
  ],
  "nodes": [
    {
      "id": "glfile",
      "type": "external",
      "stage": 0,
      "row": 0,
      "label": "總帳檔案",
      "sublabel": "xlsx、xls、CSV 或 Access"
    },
    {
      "id": "tbfile",
      "type": "external",
      "stage": 0,
      "row": 2,
      "label": "試算表檔案",
      "sublabel": "xlsx、xls、CSV 或 Access"
    },
    {
      "id": "glread",
      "type": "backend",
      "stage": 1,
      "row": 0,
      "label": "讀取 GL",
      "sublabel": "import.gl.fromFile"
    },
    {
      "id": "tbread",
      "type": "backend",
      "stage": 1,
      "row": 2,
      "label": "讀取 TB",
      "sublabel": "import.tb.fromFile"
    },
    {
      "id": "glraw",
      "type": "database",
      "stage": 2,
      "row": 0,
      "label": "PBC-GL",
      "sublabel": "staging_gl_raw_row"
    },
    {
      "id": "auditor",
      "type": "frontend",
      "stage": 3,
      "row": 1,
      "label": "審計員確認配對",
      "sublabel": "第三步"
    },
    {
      "id": "tbraw",
      "type": "database",
