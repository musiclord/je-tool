{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "審計結果如何供畫面與底稿使用",
    "locale": "zh-TW",
    "output": "archify/audit-dataflow/audit-dataflow.html",
    "quality_profile": "showcase",
    "legend": {
      "mode": "auto",
      "entries": {
        "emphasis": {
          "label": "資料庫內以 SQL 集合式處理"
        },
        "default": {
          "label": "JET 分頁讀取"
        },
        "dashed": {
          "label": "只傳摘要、定義或分頁資料"
        }
      }
    },
    "visual_preset": "editorial"
  },
  "stages": [
    {
      "label": "資料庫輸入"
    },
    {
      "label": "集合式計算"
    },
    {
      "label": "已保存結果"
    },
    {
      "label": "使用方式"
    }
  ],
  "nodes": [
    {
      "id": "population",
      "type": "database",
      "stage": 0,
      "row": 1,
      "label": "GL 與 TB",
      "sublabel": "標準化資料表"
    },
    {
      "id": "conditions",
      "type": "database",
      "stage": 0,
      "row": 2,
      "label": "情境定義",
      "sublabel": "filter_scenario"
    },
    {
      "id": "validation",
      "type": "backend",
      "stage": 1,
      "row": 0,
      "label": "驗證與預篩選",
      "sublabel": "validate.run、prescreen.run"
    },
    {
      "id": "filter",
      "type": "backend",
      "stage": 1,
      "row": 2,
      "label": "進階篩選",
      "sublabel": "條件樹轉成 SQL"
    },
    {
      "id": "summary",
      "type": "database",
      "stage": 2,
      "row": 0,
      "label": "執行摘要",
      "sublabel": "validation_result、prescreen_result"
    },
    {
      "id": "hits",
      "type": "database",
      "stage": 2,
      "row": 2,
      "label": "命中分錄",
      "sublabel": "filter_hit"
    },
    {
      "id": "screen",
      "type": "frontend",
      "stage": 3,
      "row": 0,
      "label": "畫面查詢",
      "sublabel": "摘要與分頁"
    },
    {
      "id": "workbook",
      "type": "external",
      "stage": 3,
      "row": 1,
      "label": "正式底稿",
      "sublabel": "WorkingPaperWriter"
    }
  ],
  "flows": [
    {
      "id": "population_validation",
      "from": "population",
      "to": "validation",
      "label": "計數與彙總",
      "variant": "emphasis"
    },
    {
      "id": "validation_summary",
      "from": "validation",
      "to": "summary",
      "label": "摘要 JSON",
      "variant": "dashed"
    },
    {
      "id": "conditions_filter",
      "from": "conditions",
      "to": "filter",
      "label": "條件定義",
      "variant": "dashed"
    },
    {
      "id": "population_filter",
      "from": "population",
      "to": "filter",
      "label": "測試母體",
      "variant": "emphasis"
    },
    {
      "id": "filter_hits",
      "from": "filter",
      "to": "hits",
      "label": "情境編號與分錄 ID",
      "variant": "emphasis"
    },
    {
      "id": "summary_screen",
      "from": "summary",
      "to": "screen",
      "label": "結果摘要",
      "variant": "dashed"
    },
    {
      "id": "hits_screen",
      "from": "hits",
      "to": "screen",
      "label": "命中分頁",
      "variant": "dashed",
      "labelDy": 56
    },
    {
      "id": "hits_workbook",
      "from": "hits",
      "to": "workbook",
      "label": "選取情境的命中",
      "toSide": "bottom"
    },
    {
      "id": "population_workbook",
      "from": "population",
      "to": "workbook",
      "label": "母體明細"
    },
    {
      "id": "summary_workbook",
      "from": "summary",
      "to": "workbook",
      "label": "驗證結果",
      "variant": "dashed",
      "toSide": "top"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "計算留在資料庫",
      "items": [
        "驗證與預篩選儲存摘要。進階篩選儲存命中分錄，以及分錄符合的條件。",
        "畫面讀取摘要與分頁，不載入整批分錄。"
      ]
    },
    {
      "dot": "slate",
      "title": "底稿逐頁讀取明細",
      "items": [
        "規劃時先讀摘要；WorkingPaperWriter 寫檔時再分頁讀取明細。",
        "底稿也使用欄位定義、配對與範本。這張圖只呈現 SQLite 或 DuckDB 的主要審計資料。"
      ]
    }
  ]
}
