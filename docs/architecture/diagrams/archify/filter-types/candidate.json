      "methods": [
        {
          "name": "LoadAsync",
          "parameters": "IProjectStore, string, FilterScenarioStores, JsonElement",
          "returns": "Task<Prepared>",
          "visibility": "package",
          "static": true
        },
        {
          "name": "PlanSave",
          "parameters": "Prepared, IReadOnlyList<SavedFilterScenario>, JsonElement, DateTimeOffset",
          "returns": "Change",
          "visibility": "package",
          "static": true
        },
        {
          "name": "PublishAsync",
          "parameters": "string, IProjectStore, …",
          "returns": "Task<object>",
          "visibility": "package",
          "static": true
        }
      ]
    },
    {
