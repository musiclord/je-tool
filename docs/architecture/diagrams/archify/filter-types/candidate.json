{
  "schema_version": 1,
  "diagram_type": "class",
  "meta": {
    "title": "篩選情境的處理類別",
    "locale": "zh-TW",
    "output": "archify/filter-types/filter-types.html",
    "quality_profile": "showcase",
    "legend": {
      "mode": "auto",
      "entries": {
        "dependency": {
          "label": "依賴：呼叫或建立，線上寫方法"
        },
        "realization": {
          "label": "實作介面"
        }
      }
    },
    "visual_preset": "editorial"
  },
  "layout": {
    "mode": "grid",
    "typeW": 180,
    "typeMaxW": 280,
    "gapX": 84,
    "gapY": 84
  },
  "types": [
    {
      "id": "handler",
      "label": "FilterScenarioSaveHandler",
      "kind": "class",
      "row": 0,
      "col": 0,
      "sublabel": "filter.scenario.save 的處理器",
      "methods": [
        {
          "name": "HandleAsync",
          "parameters": "JsonElement",
          "returns": "Task<object?>",
          "visibility": "public"
        }
      ]
    },
    {
      "id": "batch",
      "label": "FilterScenarioBatchWriter",
      "kind": "class",
      "row": 0,
      "col": 1,
      "sublabel": "internal static，協調整批寫入",
      "methods": [
        {
          "name": "LoadAsync",
          "parameters": "IProjectStore, string, FilterScenarioStores, JsonElement",
          "returns": "Task<Prepared>",
          "visibility": "package",
          "static": true
        },
        {
          "name": "PlanSave",
          "parameters": "Prepared, IReadOnlyList<SavedFilterScenario>, JsonElement, DateTimeOffset",
          "returns": "Change",
          "visibility": "package",
          "static": true
        },
        {
          "name": "PublishAsync",
          "parameters": "string, int, …",
          "returns": "Task<object>",
          "visibility": "package",
          "static": true
        }
      ]
    },
    {
      "id": "program",
      "label": "JetAuditProgram",
      "kind": "class",
      "row": 0,
      "col": 2.5,
      "sublabel": "AuditCore 的規劃與彙整",
      "methods": [
        {
          "name": "Plan",
          "parameters": "FilterRequest",
          "returns": "FilterPlan",
          "visibility": "package",
          "static": true
        },
        {
          "name": "PlanOneScenario",
          "parameters": "FilterRequest, SavedFilterScenario",
          "returns": "FilterPlan",
          "visibility": "package",
          "static": true
        },
        {
          "name": "Finalize",
          "parameters": "FilterPlan, FilterFacts",
          "returns": "FilterResult",
          "visibility": "package",
          "static": true
        }
      ]
    },
    {
      "id": "storeContract",
      "label": "IFilterScenarioStore",
      "kind": "interface",
      "row": 1,
      "col": 0,
      "sublabel": "情境定義的讀寫",
      "methods": [
        {
          "name": "ListAsync",
          "parameters": "string",
          "returns": "Task<IReadOnlyList<SavedFilterScenario>>",
          "visibility": "public",
          "abstract": true
        },
        {
          "name": "ReplaceAllAsync",
          "parameters": "string, IReadOnlyList<SavedFilterScenario>",
          "returns": "Task",
          "visibility": "public",
          "abstract": true
        }
      ],
      "width": 350
    },
    {
      "id": "factsContract",
      "label": "IFilterFactsPort",
      "kind": "interface",
      "row": 1,
      "col": 1,
      "sublabel": "執行篩選計畫",
      "methods": [
        {
          "name": "ExecuteAsync",
          "parameters": "FilterPlan",
          "returns": "Task<FilterFacts>",
          "visibility": "public",
          "abstract": true
        }
      ]
    },
    {
      "id": "facts",
      "label": "FilterFactsPort",
      "kind": "class",
      "row": 1,
      "col": 2,
      "sublabel": "依 action 選預覽或發布"
    },
    {
      "id": "localStore",
      "label": "LocalFilterScenarioStore",
      "kind": "class",
      "row": 2,
      "col": 0,
      "sublabel": "SQLite 與 DuckDB 共用"
    },
    {
      "id": "root",
      "label": "AppCompositionRoot",
      "kind": "class",
      "row": 2,
      "col": 1.5,
      "sublabel": "啟動時建立物件",
      "methods": [
        {
          "name": "CreateLocalProjectRepositories",
          "parameters": "string, ILocalProjectDatabase, ProjectRepositoryAssembly",
          "returns": "ProjectRepositories",
          "visibility": "private",
          "static": true
        }
      ]
    },
    {
      "id": "commitContract",
      "label": "IFilterCommitRepository",
      "kind": "interface",
      "row": 1,
      "col": 3,
      "sublabel": "發布定義與命中，或只換一個情境",
      "methods": [
        {
          "name": "CommitAsync",
          "parameters": "string, IReadOnlyList<FilterCommitItem>, FilterConditionContext",
          "returns": "Task",
          "visibility": "public",
          "abstract": true
        },
        {
          "name": "SaveOneAsync",
          "parameters": "string, FilterCommitItem, FilterConditionContext",
          "returns": "Task",
          "visibility": "public",
          "abstract": true
        }
      ]
    },
    {
      "id": "local",
      "label": "LocalFilterCommitRepository",
      "kind": "class",
      "row": 2,
      "col": 3,
      "sublabel": "SQLite 與 DuckDB 共用"
    }
  ],
  "relationships": [
    {
      "id": "handler_batch",
      "from": "handler",
      "to": "batch",
      "kind": "dependency",
      "label": "三個靜態方法"
    },
    {
      "id": "handler_store",
      "from": "handler",
      "to": "storeContract",
      "kind": "dependency",
      "label": "ListAsync"
    },
    {
      "id": "batch_program",
      "from": "batch",
      "to": "program",
      "kind": "dependency",
      "label": "Plan、PlanOneScenario、Finalize"
    },
    {
      "id": "batch_facts",
      "from": "batch",
      "to": "factsContract",
      "kind": "dependency",
      "label": "ExecuteAsync"
    },
    {
      "id": "batch_store",
      "from": "batch",
      "to": "storeContract",
      "kind": "dependency",
      "label": "ReplaceAllAsync"
    },
    {
      "id": "facts_contract",
      "from": "facts",
      "to": "factsContract",
      "kind": "realization"
    },
    {
      "id": "facts_commit",
      "from": "facts",
      "to": "commitContract",
      "kind": "dependency",
      "label": "CommitAsync、SaveOneAsync"
    },
    {
      "id": "local_commit",
      "from": "local",
      "to": "commitContract",
      "kind": "realization"
    },
    {
      "id": "localStore_store",
      "from": "localStore",
      "to": "storeContract",
      "kind": "realization"
    },
    {
      "id": "root_localStore",
      "from": "root",
      "to": "localStore",
      "kind": "dependency",
      "label": "建立"
    },
    {
      "id": "root_facts",
      "from": "root",
      "to": "facts",
      "kind": "dependency",
      "label": "建立"
    },
    {
      "id": "root_local",
      "from": "root",
      "to": "local",
      "kind": "dependency",
      "label": "建立"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "圖中涵蓋的範圍",
      "items": [
        "本圖呈現 SQLite 或 DuckDB 的儲存流程；預覽與 SQL Server 實作未列入。",
        "AppCompositionRoot 建立 FilterFactsPort、LocalFilterCommitRepository 與 LocalFilterScenarioStore。"
      ]
    },
    {
      "dot": "slate",
      "title": "另外參與的元件",
      "items": [
        "FilterScenarioBatchWriter 也會讀取結果是否過期，再決定單筆或整批處理。",
        "推進案件步驟由 MappingCommitShared.AdvanceStepAsync 處理，分支見流程圖。"
      ]
    }
  ]
}
