  "cards": [
    {
      "dot": "cyan",
      "title": "從選檔到寫入",
      "items": [
        "本圖是正常完成取代匯入的流程。未指定 mode 時採取代方式。",
        "先讀完所有檔案標頭，再逐列寫入同一筆交易。追加匯入另走 AppendToBatchAsync。"
      ]
    },
    {
      "dot": "slate",
      "title": "參與者與程式類別",
      "items": [
        "匯入畫面：JetApi。",
        "action 通道：ActionDispatcher。",
        "TB 匯入處理：ImportTbFromFileHandler。",
        "匯入執行：IntakeFactsPort。",
        "表格檔讀取：ITabularFileReader。",
        "案件資料庫：SQLite。",
        "案件進度檔：JsonFileProjectStore。"
      ]
    },
    {
      "dot": "slate",
      "title": "共用分派",
      "items": [
        "IApplicationActionHandler.HandleAsync：依 action 名稱找處理類別。"
      ]
    },
    {
      "dot": "slate",
      "title": "準備",
      "items": [
        "IImportRepository.GetLatestBatchAsync：先由 JetAuditProgram 建立計畫，再讀前一批次。",
        "ITabularFileReader.ReadColumnsAsync：逐一讀完所有來源的標頭。",
        "ITabularFileReader.ReadRowsAsync：先準備讀取方式，還沒讀資料列。"
      ]
    },
    {
      "dot": "slate",
      "title": "同一筆交易",
      "items": [
        "IIntakeFactsPort.ExecuteAsync：在背景執行，傳入計畫與各來源的資料列。",
        "IImportRepository.ReplaceBatchAsync：取代匯入時刪除舊批次與受影響的結果。",
        "逐列讀取：逐列寫入原始列資料表，每 20,000 列回報一次進度。",
        "ImportBatchResult：提交前會檢查是否已取消。"
      ]
    },
    {
      "dot": "slate",
      "title": "提交之後",
      "items": [
        "IProjectStore.SaveAsync：案件步驟落後才更新；失敗記在支援日誌。",
        "IProjectOperationLog.TryAppendAsync：只在取代了舊批次時寫；經 CommittedOperationLog 呼叫，失敗時回應附提醒。",
        "批次摘要與失效狀態：讀回失效狀態與報告清單；讀不回時仍回應成功並附提醒。",
        "回應：完成以回應為準，沒有完成事件。"
      ]
    },
    {
      "dot": "slate",
      "title": "寫入後的處理",
      "items": [
        "提交後才更新案件步驟與操作紀錄。紀錄失敗會附提醒，已提交的匯入仍保留。",
        "清除範圍與取消處理見「取代匯入 TB」流程圖。"
      ]
    }
  ],
