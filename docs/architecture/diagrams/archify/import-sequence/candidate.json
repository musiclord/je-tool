{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "取代匯入 TB：呼叫順序",
    "locale": "zh-TW",
    "output": "archify/import-sequence/import-sequence.html",
    "quality_profile": "showcase",
    "legend": {
      "mode": "auto",
      "entries": {
        "default": {
          "label": "直接呼叫"
        },
        "dashed": {
          "label": "介面呼叫"
        },
        "emphasis": {
          "label": "間接觸發"
        },
        "return": {
          "label": "回傳"
        }
      }
    },
    "visual_preset": "editorial"
  },
  "participants": [
    {
      "id": "ui",
      "type": "frontend",
      "label": "匯入畫面",
      "sublabel": "JetApi"
    },
    {
      "id": "route",
      "type": "backend",
      "label": "action 通道",
      "sublabel": "ActionDispatcher"
    },
    {
      "id": "handler",
      "type": "backend",
      "label": "TB 匯入處理",
      "sublabel": "ImportTbFromFileHandler"
    },
    {
      "id": "reader",
      "type": "backend",
      "label": "表格檔讀取",
      "sublabel": "ITabularFileReader"
    },
    {
      "id": "port",
      "type": "backend",
      "label": "匯入執行",
      "sublabel": "IntakeFactsPort"
    },
    {
      "id": "db",
      "type": "database",
      "label": "案件資料庫",
      "sublabel": "SQLite 或 DuckDB"
    },
    {
      "id": "project",
      "type": "database",
      "label": "案件進度檔",
      "sublabel": "JsonFileProjectStore"
    }
  ],
  "segments": [
    {
      "from": 150,
      "to": 274,
      "label": "共用分派：與篩選儲存圖相同"
    },
    {
      "from": 306,
      "to": 575,
      "label": "準備：任一來源的標頭讀取失敗就不寫入"
    },
    {
      "from": 607,
      "to": 931,
      "label": "同一筆交易：取代批次與資料列，失敗時嘗試回復"
    },
    {
      "from": 963,
      "to": 1213,
      "label": "提交之後：不再接受取消"
    }
  ],
  "messages": [
    {
      "id": "m01",
      "from": "ui",
      "to": "route",
      "y": 180,
      "label": "import.tb.fromFile",
      "variant": "emphasis",
      "note": "沒有指定 mode 就是取代匯入"
    },
    {
      "id": "m02",
      "from": "route",
      "to": "handler",
      "y": 240,
      "label": "IApplicationActionHandler.HandleAsync",
      "variant": "dashed",
      "note": "依 action 名稱找處理類別"
    },
    {
      "id": "m03",
      "from": "handler",
      "to": "db",
      "y": 336,
      "label": "IImportRepository.GetLatestBatchAsync",
      "variant": "dashed",
      "note": "讀前一批次；先由 JetAuditProgram 建立計畫"
    },
    {
      "id": "m04",
      "from": "db",
      "to": "handler",
      "y": 398,
      "label": "前一批次",
      "variant": "return"
    },
    {
      "id": "m05",
      "from": "handler",
      "to": "reader",
      "y": 438,
      "label": "ITabularFileReader.ReadColumnsAsync",
      "variant": "dashed",
      "note": "逐一讀完所有來源的標頭"
    },
    {
      "id": "m06",
      "from": "reader",
      "to": "handler",
      "y": 490,
      "label": "欄位清單",
      "variant": "return"
    },
    {
      "id": "m07",
      "from": "handler",
      "to": "reader",
      "y": 530,
      "label": "ITabularFileReader.ReadRowsAsync",
      "variant": "dashed",
      "note": "先準備讀取方式，還沒讀資料列"
    },
    {
      "id": "m08",
      "from": "handler",
      "to": "port",
      "y": 637,
      "label": "IIntakeFactsPort.ExecuteAsync",
      "variant": "dashed",
      "note": "在背景執行，傳入計畫與各來源的資料列"
    },
    {
      "id": "m09",
      "from": "port",
      "to": "db",
      "y": 699,
      "label": "IImportRepository.ReplaceBatchAsync",
      "variant": "dashed",
      "note": "取代匯入：刪除舊批次與受影響的結果"
    },
    {
      "id": "m10",
      "from": "db",
      "to": "reader",
      "y": 761,
      "label": "逐列讀取",
      "variant": "emphasis",
      "note": "逐列寫入原始列資料表；每 20,000 列回報一次進度"
    },
    {
      "id": "m11",
      "from": "reader",
      "to": "db",
      "y": 823,
      "label": "資料列",
      "variant": "return"
    },
    {
      "id": "m12",
      "from": "db",
      "to": "port",
      "y": 863,
      "label": "ImportBatchResult",
      "variant": "return",
      "note": "提交前檢查取消"
    },
    {
      "id": "m13",
      "from": "port",
      "to": "handler",
      "y": 915,
      "label": "IntakeFacts",
      "variant": "return"
    },
    {
      "id": "m14",
      "from": "handler",
      "to": "project",
      "y": 993,
      "label": "IProjectStore.SaveAsync",
      "variant": "dashed",
      "note": "案件步驟落後才更新；失敗記在支援日誌"
    },
    {
      "id": "m15",
      "from": "handler",
      "to": "db",
      "y": 1055,
      "label": "IProjectOperationLog.TryAppendAsync",
      "variant": "dashed",
      "note": "只在取代了舊批次時寫；經 CommittedOperationLog 呼叫，失敗回應附提醒"
    },
    {
      "id": "m16",
      "from": "handler",
      "to": "route",
      "y": 1117,
      "label": "批次摘要與失效狀態",
      "variant": "return",
      "note": "讀回失效狀態與報告清單；讀不回時仍回應成功並附提醒"
    },
    {
      "id": "m17",
      "from": "route",
      "to": "ui",
      "y": 1179,
      "label": "回應",
      "variant": "return",
      "note": "完成以回應為準，沒有完成事件"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "從選檔到寫入",
      "items": [
        "本圖是 SQLite 或 DuckDB 案件正常完成取代匯入的流程。未指定 mode 時採取代方式。",
        "先讀完所有檔案標頭，再逐列寫入同一筆交易。追加匯入另走 AppendToBatchAsync。"
      ]
    },
    {
      "dot": "slate",
      "title": "寫入後的處理",
      "items": [
        "提交後才更新案件步驟與操作紀錄。紀錄失敗會附提醒，已提交的匯入仍保留。",
        "清除範圍與取消處理見「取代匯入 TB」流程圖。"
      ]
    }
  ],
