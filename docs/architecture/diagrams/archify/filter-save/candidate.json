{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "儲存篩選情境",
    "locale": "zh-TW",
    "output": "archify/filter-save/filter-save.html",
    "quality_profile": "showcase",
    "legend": {
      "mode": "auto",
      "entries": {
        "frontend": {
          "label": "畫面操作與回應"
        },
        "backend": {
          "label": "JET 檢查與判斷"
        },
        "database": {
          "label": "寫入案件資料庫"
        }
      }
    },
    "visual_preset": "editorial"
  },
  "lanes": [
    {
      "id": "operate",
      "label": "審計員與畫面"
    },
    {
      "id": "check",
      "label": "儲存前檢查"
    },
    {
      "id": "stop",
      "label": "不寫入",
      "variant": "exception"
    },
    {
      "id": "one",
      "label": "只存這一個情境"
    },
    {
      "id": "valid",
      "label": "整批處理：全部合格"
    },
    {
      "id": "invalid",
      "label": "整批處理：仍有不合格"
    }
  ],
  "phases": [
    {
      "id": "cancellable",
      "label": "提交前可以取消",
      "fromCol": 0,
      "toCol": 4
    },
    {
      "id": "after",
      "label": "提交後不再取消",
      "fromCol": 5,
      "toCol": 5
    }
  ],
  "nodes": [
    {
      "id": "request",
      "lane": "operate",
      "col": 0,
      "type": "frontend",
      "label": "按下儲存",
      "sublabel": "filter.scenario.save"
    },
    {
      "id": "load",
      "lane": "check",
      "col": 0,
      "type": "backend",
      "label": "確認前提",
      "sublabel": "驗證是目前版本，GL 已配對"
    },
    {
      "id": "list",
      "lane": "check",
      "col": 1,
      "type": "backend",
      "label": "讀出已存情境",
      "sublabel": "其他情境照原樣保留"
    },
    {
      "id": "rules",
      "lane": "check",
      "col": 2,
      "type": "backend",
      "label": "檢查本次情境",
      "sublabel": "上限、位置、名稱與儲存規則"
    },
    {
      "id": "decide",
      "lane": "check",
      "col": 3,
      "type": "backend",
      "label": "決定儲存範圍",
      "sublabel": "本次情境或全部情境",
      "icon": "decision"
    },
    {
      "id": "one",
      "lane": "one",
      "col": 4,
      "type": "database",
      "label": "只換這一個情境",
      "sublabel": "其他情境的結果照原樣"
    },
    {
      "id": "commit",
      "lane": "valid",
      "col": 4,
      "type": "database",
      "label": "儲存全部情境與結果",
      "sublabel": "篩選結果更新為目前版本"
    },
    {
      "id": "defs",
      "lane": "invalid",
      "col": 4,
      "type": "database",
      "label": "只儲存情境設定",
      "sublabel": "清除命中，標出待修情境"
    },
    {
      "id": "reply",
      "lane": "operate",
      "col": 5,
      "type": "frontend",
      "label": "讀回最新狀態",
      "sublabel": "有存下結果才推進到第五步"
    },
    {
      "id": "reject",
      "lane": "stop",
      "col": 1,
      "type": "backend",
      "label": "回錯誤，不寫入",
      "sublabel": "本次修改未儲存",
      "icon": "stop"
    }
  ],
  "edges": [
    {
      "id": "request_load",
      "from": "request",
      "to": "load"
    },
    {
      "id": "load_list",
      "from": "load",
      "to": "list"
    },
    {
      "id": "list_rules",
      "from": "list",
      "to": "rules"
    },
    {
      "id": "rules_decide",
      "from": "rules",
      "to": "decide"
    },
    {
      "id": "load_reject",
      "from": "load",
      "to": "reject",
      "label": "前提不符",
      "role": "error"
    },
    {
      "id": "rules_reject",
      "from": "rules",
      "to": "reject",
      "label": "本次不合格",
      "role": "error"
    },
    {
      "id": "decide_one",
      "from": "decide",
      "to": "one",
      "label": "平常"
    },
    {
      "id": "decide_commit",
      "from": "decide",
      "to": "commit",
      "label": "整批合格"
    },
    {
      "id": "decide_defs",
      "from": "decide",
      "to": "defs",
      "label": "仍有不合格"
    },
    {
      "id": "one_reply",
      "from": "one",
      "to": "reply"
    },
    {
      "id": "commit_reply",
      "from": "commit",
      "to": "reply"
    },
    {
      "id": "defs_reply",
      "from": "defs",
      "to": "reply"
    }
  ],
  "mainPath": [
    "request",
    "load",
    "list",
    "rules",
    "decide",
    "one",
    "reply"
  ],
  "semanticChecks": {
    "allowedRoots": [
      "request"
    ],
    "allowedTerminals": [
      "reply",
      "reject"
    ],
    "requiredEdges": [
      {
        "from": "decide",
        "to": "one"
      },
      {
        "from": "decide",
        "to": "commit"
      },
      {
        "from": "decide",
        "to": "defs"
      },
      {
        "from": "rules",
        "to": "reject"
      }
    ]
  },
  "cards": [
    {
      "dot": "cyan",
      "title": "何時只存本次情境",
      "items": [
        "其他情境都合格、符合目前規則，而且結果未過期時，只取代本次情境的定義與命中。",
        "新增情境放在清單最後；取代時核對位置與名稱。案件、驗證或 GL 配對不符時不儲存。"
      ]
    },
    {
      "dot": "slate",
      "title": "何時整批處理",
      "items": [
        "全部合格就重算並儲存全部結果；仍有情境待修時，只存定義、清除命中，並標出待修項目。",
        "提交前可取消；提交後讀回狀態。有存下結果才推進至第五步，步驟更新失敗記錄日誌。"
      ]
    }
  ]
}
