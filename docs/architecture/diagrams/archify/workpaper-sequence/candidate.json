{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "匯出正式底稿：呼叫順序",
    "locale": "zh-TW",
    "output": "archify/workpaper-sequence/workpaper-sequence.html",
    "quality_profile": "showcase",
    "legend": {
      "mode": "auto",
      "entries": {
        "default": {
          "label": "直接呼叫"
        },
        "dashed": {
          "label": "介面呼叫"
        },
        "emphasis": {
          "label": "間接觸發"
        },
        "return": {
          "label": "回傳"
        }
      }
    },
    "visual_preset": "editorial"
  },
  "participants": [
    {
      "id": "ui",
      "type": "frontend",
      "label": "第六步畫面",
      "sublabel": "JetApi"
    },
    {
      "id": "handler",
      "type": "backend",
      "label": "底稿匯出處理",
      "sublabel": "export.workingPaperStream"
    },
    {
      "id": "facts",
      "type": "backend",
      "label": "讀規劃資料",
      "sublabel": "WorkingPaperPlanningFactsPort"
    },
    {
      "id": "audited",
      "type": "backend",
      "label": "記錄發布",
      "sublabel": "AuditedReportStore"
    },
    {
      "id": "files",
      "type": "database",
      "label": "寫檔與發布",
      "sublabel": "ProjectReportStore"
    },
    {
      "id": "writer",
      "type": "backend",
      "label": "工作簿寫出",
      "sublabel": "WorkingPaperWriter"
    }
  ],
  "segments": [
    {
      "from": 150,
      "to": 338,
      "label": "準備：核對版本，確認存好的結果，再讀規劃資料"
    },
    {
      "from": 352,
      "to": 708,
      "label": "寫暫存檔：這一段可以取消"
    },
    {
      "from": 722,
      "to": 972,
      "label": "發布：改名前最後檢查取消，之後不再接受取消"
    }
  ],
  "messages": [
    {
      "id": "m01",
      "from": "ui",
      "to": "handler",
      "y": 180,
      "label": "WebMessage",
      "variant": "emphasis",
      "note": "經 ActionDispatcher 分派給這個 action 的處理類別"
    },
    {
      "id": "m02",
      "from": "handler",
      "to": "facts",
      "y": 242,
      "label": "IWorkingPaperPlanningFactsPort.ExecuteAsync",
      "variant": "dashed",
      "note": "先由 JetAuditProgram 建立計畫"
    },
    {
      "id": "m03",
      "from": "facts",
      "to": "handler",
      "y": 304,
      "label": "WorkingPaperPlanningFacts",
      "variant": "return"
    },
    {
      "id": "m04",
      "from": "handler",
      "to": "audited",
      "y": 382,
      "label": "IAuditedReportPublishingStore.WriteAuditedAsync",
      "variant": "dashed",
      "note": "先數既有報告，再交給下一層寫檔"
    },
    {
      "id": "m05",
      "from": "audited",
      "to": "files",
      "y": 444,
      "label": "IReportPublishingStore.WriteWithPublishingAsync",
      "variant": "dashed",
      "note": "鎖住報告目錄，讀出報告清單"
    },
    {
      "id": "m06",
      "from": "files",
      "to": "handler",
      "y": 506,
      "label": "ReportContentWriter",
      "variant": "emphasis",
      "note": "把暫存 .tmp 檔交給寫檔程式"
    },
    {
      "id": "m07",
      "from": "handler",
      "to": "writer",
      "y": 568,
      "label": "IWorkingPaperPlanWriter.WriteAsync",
      "variant": "dashed",
      "note": "依計畫分頁讀資料列，寫入工作簿"
    },
    {
      "id": "m08",
      "from": "writer",
      "to": "handler",
      "y": 630,
      "label": "ExportStats",
      "variant": "return"
    },
    {
      "id": "m09",
      "from": "handler",
      "to": "files",
      "y": 674,
      "label": "暫存檔寫完",
      "variant": "return"
    },
    {
      "id": "m10",
      "from": "files",
      "to": "handler",
      "y": 752,
      "label": "publishingReport",
      "variant": "emphasis",
      "note": "全部暫存檔寫完才通知，畫面進度改成發布中"
    },
    {
      "id": "m11",
      "from": "files",
      "to": "audited",
      "y": 814,
      "label": "Report",
      "variant": "return",
      "note": "改名成正式檔名，不覆寫同名底稿，再更新報告清單"
    },
    {
      "id": "m12",
      "from": "audited",
      "to": "handler",
      "y": 876,
      "label": "Report",
      "variant": "return",
      "note": "經 CommittedOperationLog 寫入 report.publish 操作紀錄；失敗回提醒"
    },
    {
      "id": "m13",
      "from": "handler",
      "to": "ui",
      "y": 938,
      "label": "產出檔案、各表列數與清單",
      "variant": "return",
      "note": "讀回最新報告清單與失效狀態；提醒一起回"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "匯出前先確認",
      "items": [
        "驗證結果必須符合目前版本。有篩選情境時，也要核對情境版本與位置；尚未儲存情境仍可匯出。",
        "結果過期時，只重算選取的情境。規劃時先讀摘要，寫檔時再分頁讀明細。"
      ]
    },
    {
      "dot": "slate",
      "title": "寫檔與紀錄分工",
      "items": [
        "ProjectReportStore 寫暫存檔、改名並更新清單；AuditedReportStore 在成功後記錄這次發布。",
        "操作紀錄失敗時附提醒，已發布底稿仍保留。發布失敗的還原方式見流程圖。"
      ]
    }
  ],
  "activations": [
    {
      "participant": "handler",
      "from": 180,
      "to": 938
    },
    {
      "participant": "facts",
      "from": 242,
      "to": 304
    },
    {
      "participant": "audited",
      "from": 382,
      "to": 876
    },
    {
      "participant": "files",
      "from": 444,
      "to": 814
    },
    {
      "participant": "writer",
      "from": 568,
      "to": 630
    }
  ]
}
