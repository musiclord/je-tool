{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "匯出正式底稿",
    "locale": "zh-TW",
    "output": "archify/workpaper/workpaper.html",
    "quality_profile": "showcase",
    "legend": {
      "mode": "auto",
      "entries": {
        "frontend": {
          "label": "畫面操作與回應"
        },
        "backend": {
          "label": "JET 處理與判斷"
        },
        "database": {
          "label": "讀寫案件資料或檔案"
        }
      }
    },
    "visual_preset": "editorial"
  },
  "lanes": [
    {
      "id": "operate",
      "label": "審計員與畫面"
    },
    {
      "id": "plan",
      "label": "規劃，不寫檔"
    },
    {
      "id": "files",
      "label": "報告目錄"
    },
    {
      "id": "fail",
      "label": "失敗處理",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "cancellable",
      "label": "可以取消",
      "fromCol": 0,
      "toCol": 3
    },
    {
      "id": "publish",
      "label": "發布後不再取消",
      "fromCol": 4,
      "toCol": 5
    }
  ],
  "nodes": [
    {
      "id": "request",
      "lane": "operate",
      "col": 0,
      "type": "frontend",
      "label": "匯出正式底稿",
      "sublabel": "export.workingPaperStream"
    },
    {
      "id": "versions",
      "lane": "plan",
      "col": 1,
      "type": "backend",
      "label": "核對目前版本",
      "sublabel": "驗證結果、情境版本與位置"
    },
    {
      "id": "recompute",
      "lane": "plan",
      "col": 2,
      "type": "database",
      "label": "確認篩選結果",
      "sublabel": "過期時只重算選取的情境"
    },
    {
      "id": "facts",
      "lane": "plan",
      "col": 3,
      "type": "backend",
      "label": "建立底稿計畫",
      "sublabel": "規劃、讀資料與彙整"
    },
    {
      "id": "stage",
      "lane": "files",
      "col": 3,
      "type": "database",
      "label": "寫完暫存檔",
      "sublabel": "依計畫分頁讀資料列"
    },
    {
      "id": "rename",
      "lane": "files",
      "col": 4,
      "type": "database",
      "label": "改名成新版本",
      "sublabel": "不覆寫同名底稿"
    },
    {
      "id": "manifest",
      "lane": "files",
      "col": 5,
      "type": "database",
      "label": "更新報告清單",
      "sublabel": "reports.json，再寫操作紀錄"
    },
    {
      "id": "reply",
      "lane": "operate",
      "col": 5,
      "type": "frontend",
      "label": "回應檔案與列數",
      "sublabel": "讀回最新報告清單"
    },
    {
      "id": "reject",
      "lane": "fail",
      "col": 1,
      "type": "frontend",
      "label": "回報版本不符",
      "sublabel": "尚未寫任何檔案",
      "icon": "stop"
    },
    {
      "id": "cleanup",
      "lane": "fail",
      "col": 3,
      "type": "backend",
      "label": "刪除本次暫存檔",
      "sublabel": "寫入失敗或取消"
    },
    {
      "id": "restore",
      "lane": "fail",
      "col": 5,
      "type": "backend",
      "label": "還原已改名的檔案",
      "sublabel": "還原失敗會保留備份"
    },
    {
      "id": "report",
      "lane": "fail",
      "col": 4,
      "type": "frontend",
      "label": "回報可處理的原因",
      "sublabel": "既有底稿沒有被覆寫",
      "icon": "stop"
    }
  ],
  "edges": [
    {
      "id": "request_versions",
      "from": "request",
      "to": "versions"
    },
    {
      "id": "versions_recompute",
      "from": "versions",
      "to": "recompute"
    },
    {
      "id": "recompute_facts",
      "from": "recompute",
      "to": "facts"
    },
    {
      "id": "facts_stage",
      "from": "facts",
      "to": "stage"
    },
    {
      "id": "stage_rename",
      "from": "stage",
      "to": "rename"
    },
    {
      "id": "rename_manifest",
      "from": "rename",
      "to": "manifest"
    },
    {
      "id": "manifest_reply",
      "from": "manifest",
      "to": "reply"
    },
    {
      "id": "versions_reject",
      "from": "versions",
      "to": "reject",
      "label": "不是目前版本",
      "role": "error"
    },
    {
      "id": "stage_cleanup",
      "from": "stage",
      "to": "cleanup",
      "label": "失敗或取消",
      "role": "error"
    },
    {
      "id": "cleanup_report",
      "from": "cleanup",
      "to": "report"
    },
    {
      "id": "rename_restore",
      "from": "rename",
      "to": "restore",
      "label": "改名失敗",
      "role": "error"
    },
    {
      "id": "manifest_restore",
      "from": "manifest",
      "to": "restore",
      "label": "更新清單失敗",
      "role": "error"
    },
    {
      "id": "restore_report",
      "from": "restore",
      "to": "report"
    }
  ],
  "mainPath": [
    "request",
    "versions",
    "recompute",
    "facts",
    "stage",
    "rename",
    "manifest",
    "reply"
  ],
  "semanticChecks": {
    "allowedRoots": [
      "request"
    ],
    "allowedTerminals": [
      "reply",
      "reject",
      "report"
    ],
    "requiredEdges": [
      {
        "from": "versions",
        "to": "reject"
      },
      {
        "from": "manifest",
        "to": "restore"
      }
    ]
  },
  "cards": [
    {
      "dot": "cyan",
      "title": "匯出內容",
      "items": [
        "核對驗證結果、情境版本與位置後，使用已存結果；過期時只重算選取的情境。尚未儲存情境仍可匯出。",
        "JET 產生檔名與工作表，每次另存新版本，保留同名舊檔。"
      ]
    },
    {
      "dot": "amber",
      "title": "發布與失敗處理",
      "items": [
        "暫存檔寫完後，改名前最後檢查取消，再更新 reports.json。此後不再接受取消。",
        "發布失敗會嘗試還原；還原失敗保留備份或新檔，程式當機時不保證全部還原。操作紀錄失敗會附提醒。"
      ]
    }
  ]
}
