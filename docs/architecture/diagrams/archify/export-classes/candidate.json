{
  "schema_version": 1,
  "diagram_type": "class",
  "meta": {
    "title": "正式底稿的處理類別怎麼準備資料",
    "locale": "zh-TW",
    "output": "archify/export-classes/export-classes.html",
    "quality_profile": "showcase",
    "legend": {
      "mode": "auto",
      "entries": {
        "dependency": {
          "label": "依賴：呼叫或建立，線上寫方法"
        },
        "realization": {
          "label": "實作介面"
        }
      }
    },
    "visual_preset": "editorial"
  },
  "layout": {
    "mode": "grid",
    "typeW": 180,
    "typeMaxW": 300,
    "gapX": 108,
    "gapY": 84
  },
  "types": [
    {
      "id": "handler",
      "label": "ExportWorkingPaperStreamHandler",
      "kind": "class",
      "row": 0,
      "col": 0,
      "sublabel": "export.workingPaperStream",
      "methods": [
        {
          "name": "HandleAsync",
          "parameters": "JsonElement",
          "returns": "Task<object?>",
          "visibility": "public"
        }
      ],
      "width": 430
    },
    {
      "id": "program",
      "label": "JetAuditProgram",
      "kind": "class",
      "row": 0,
      "col": 1,
      "sublabel": "規劃底稿並整理結果",
      "methods": [
        {
          "name": "Plan",
          "parameters": "WorkingPaperRequest",
          "returns": "WorkingPaperPlan",
          "visibility": "package",
          "static": true
        },
        {
          "name": "Finalize",
          "parameters": "WorkingPaperPlan, WorkingPaperPlanningFacts",
          "returns": "WorkingPaperPlan",
          "visibility": "package",
          "static": true
        }
      ],
      "width": 470
    },
    {
      "id": "materialize",
      "label": "FilterHitMaterializeService",
      "kind": "class",
      "row": 1,
      "col": 0,
      "sublabel": "確認或重算選取的情境",
      "methods": [
        {
          "name": "RequireUsableAsync",
          "parameters": "string, ProjectDocument, …",
          "returns": "Task",
          "visibility": "public"
        },
        {
          "name": "MaterializeSelectedAsync",
          "parameters": "string, ProjectDocument, …",
          "returns": "Task",
          "visibility": "public"
        }
      ],
      "width": 430
    },
    {
      "id": "factsContract",
      "label": "IWorkingPaperPlanningFactsPort",
      "kind": "interface",
      "row": 1,
      "col": 1,
      "sublabel": "讀規劃需要的資料",
      "methods": [
        {
          "name": "ExecuteAsync",
          "parameters": "WorkingPaperPlan",
          "returns": "Task<WorkingPaperPlanningFacts>",
          "visibility": "public",
          "abstract": true
        }
      ],
      "width": 470
    },
    {
      "id": "root",
      "label": "AppCompositionRoot",
      "kind": "class",
      "row": 2,
      "col": 0,
      "sublabel": "啟動時建立物件",
      "methods": [
        {
          "name": "CreateLocalProjectRepositories",
          "parameters": "string, ILocalProjectDatabase, ProjectRepositoryAssembly",
          "returns": "ProjectRepositories",
          "visibility": "private",
          "static": true
        }
      ],
      "width": 430
    },
    {
      "id": "facts",
      "label": "WorkingPaperPlanningFactsPort",
      "kind": "class",
      "row": 2,
      "col": 1,
      "sublabel": "不分資料庫"
    }
  ],
  "relationships": [
    {
      "id": "handler_materialize",
      "from": "handler",
      "to": "materialize",
      "kind": "dependency",
      "label": "確認或重算"
    },
    {
      "id": "handler_program",
      "from": "handler",
      "to": "program",
      "kind": "dependency",
      "label": "Plan、Finalize"
    },
    {
      "id": "handler_facts",
      "from": "handler",
      "to": "factsContract",
      "kind": "dependency",
      "label": "ExecuteAsync",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "facts_contract",
      "from": "facts",
      "to": "factsContract",
      "kind": "realization"
    },
    {
      "id": "root_facts",
      "from": "root",
      "to": "facts",
      "kind": "dependency",
      "label": "建立"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "產生底稿前的準備",
      "items": [
        "ExportWorkingPaperStreamHandler 先確認選定的情境：結果標成過期時呼叫 MaterializeSelectedAsync 重算，否則呼叫 RequireUsableAsync 確認仍能套用。接著由 JetAuditProgram 規劃底稿，經 IWorkingPaperPlanningFactsPort 讀取規劃需要的資料。",
        "方法的參數只列前幾項，省略的部分以「…」表示；完整宣告見連線證據頁。"
      ]
    },
    {
      "dot": "slate",
      "title": "寫檔與發布",
      "items": [
        "寫出工作簿、發布底稿與寫操作紀錄的類別，見「正式底稿怎麼寫檔與發布」。"
      ]
    }
  ]
}
