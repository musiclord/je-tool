{
  "schema_version": 1,
  "diagram_type": "class",
  "meta": {
    "title": "正式底稿的處理類別",
    "locale": "zh-TW",
    "output": "archify/export-classes/export-classes.html",
    "quality_profile": "showcase",
    "legend": {
      "mode": "auto",
      "entries": {
        "dependency": {
          "label": "依賴：呼叫或建立，線上寫方法"
        },
        "realization": {
          "label": "實作介面"
        }
      }
    },
    "visual_preset": "editorial"
  },
  "layout": {
    "mode": "grid",
    "typeW": 180,
    "typeMaxW": 280,
    "gapX": 84,
    "gapY": 84
  },
  "types": [
    {
      "id": "handler",
      "label": "ExportWorkingPaperStreamHandler",
      "kind": "class",
      "row": 0,
      "col": 1.5,
      "sublabel": "export.workingPaperStream",
      "methods": [
        {
          "name": "HandleAsync",
          "parameters": "JsonElement",
          "returns": "Task<object?>",
          "visibility": "public"
        }
      ]
    },
    {
      "id": "materialize",
      "label": "FilterHitMaterializeService",
      "kind": "class",
      "row": 0,
      "col": 0,
      "sublabel": "確認或重算選取的情境",
      "methods": [
        {
          "name": "RequireUsableAsync",
          "parameters": "string, ProjectDocument, IReadOnlyList<SavedFilterScenario>, IReadOnlyCollection<int>?",
          "returns": "Task",
          "visibility": "public"
        },
        {
          "name": "MaterializeSelectedAsync",
          "parameters": "string, ProjectDocument, IReadOnlyList<SavedFilterScenario>, IReadOnlyCollection<int>",
          "returns": "Task",
          "visibility": "public"
        }
      ]
    },
    {
      "id": "program",
      "label": "JetAuditProgram",
      "kind": "class",
      "row": 0,
      "col": 3,
      "sublabel": "規劃底稿並整理結果",
      "methods": [
        {
          "name": "Plan",
          "parameters": "WorkingPaperRequest",
          "returns": "WorkingPaperPlan",
          "visibility": "package",
          "static": true
        },
        {
          "name": "Finalize",
          "parameters": "WorkingPaperPlan, WorkingPaperPlanningFacts",
          "returns": "WorkingPaperPlan",
          "visibility": "package",
          "static": true
        }
      ]
    },
    {
      "id": "factsContract",
      "label": "IWorkingPaperPlanningFactsPort",
      "kind": "interface",
      "row": 1,
      "col": 0,
      "sublabel": "讀規劃需要的資料",
      "methods": [
        {
          "name": "ExecuteAsync",
          "parameters": "WorkingPaperPlan",
          "returns": "Task<WorkingPaperPlanningFacts>",
          "visibility": "public",
          "abstract": true
        }
      ]
    },
    {
      "id": "writerContract",
      "label": "IWorkingPaperPlanWriter",
      "kind": "interface",
      "row": 1,
      "col": 1,
      "sublabel": "寫入工作簿",
      "methods": [
        {
          "name": "WriteAsync",
          "parameters": "Stream, WorkingPaperContext, WorkingPaperPlan",
          "returns": "Task<ExportStats>",
          "visibility": "public",
          "abstract": true
        }
      ]
    },
    {
      "id": "auditedContract",
      "label": "IAuditedReportPublishingStore",
      "kind": "interface",
      "row": 1,
      "col": 2,
      "sublabel": "發布並回操作紀錄的提醒",
      "methods": [
        {
          "name": "WriteAuditedAsync",
          "parameters": "string, ReportWriteRequest, Action<ReportKind>",
          "returns": "Task<AuditedReportPublication>",
          "visibility": "public",
          "abstract": true
        }
      ]
    },
    {
      "id": "publishContract",
      "label": "IReportPublishingStore",
      "kind": "interface",
      "row": 1,
      "col": 3,
      "sublabel": "寫檔並通知發布",
      "methods": [
        {
          "name": "WriteWithPublishingAsync",
          "parameters": "string, ReportWriteRequest, Action<ReportKind>",
          "returns": "Task<Report>",
          "visibility": "public",
          "abstract": true
        }
      ]
    },
    {
      "id": "facts",
      "label": "WorkingPaperPlanningFactsPort",
      "kind": "class",
      "row": 2,
      "col": 0,
      "sublabel": "不分資料庫"
    },
    {
      "id": "writer",
      "label": "WorkingPaperWriter",
      "kind": "class",
      "row": 2,
      "col": 1,
      "sublabel": "分頁讀取並寫出"
    },
    {
      "id": "audited",
      "label": "AuditedReportStore",
      "kind": "class",
      "row": 2,
      "col": 2,
      "sublabel": "外層：寫操作紀錄"
    },
    {
      "id": "files",
      "label": "ProjectReportStore",
      "kind": "class",
      "row": 2,
      "col": 3,
      "sublabel": "內層：暫存檔、改名與清單"
    },
    {
      "id": "root",
      "label": "AppCompositionRoot",
      "kind": "class",
      "row": 3,
      "col": 1,
      "sublabel": "啟動時建立物件",
      "methods": [
        {
          "name": "CreateRuntimeCore",
          "parameters": "IHostShell, string, …",
          "returns": "JetApplicationRuntime",
          "visibility": "private",
          "static": true
        },
        {
          "name": "CreateLocalProjectRepositories",
          "parameters": "string, ILocalProjectDatabase, ProjectRepositoryAssembly",
          "returns": "ProjectRepositories",
          "visibility": "private",
          "static": true
        }
      ]
    }
  ],
  "relationships": [
    {
      "id": "handler_materialize",
      "from": "handler",
      "to": "materialize",
      "kind": "dependency",
      "label": "RequireUsableAsync、MaterializeSelectedAsync"
    },
    {
      "id": "handler_program",
      "from": "handler",
      "to": "program",
      "kind": "dependency",
      "label": "Plan、Finalize"
    },
    {
      "id": "handler_facts",
      "from": "handler",
      "to": "factsContract",
      "kind": "dependency",
      "label": "ExecuteAsync"
    },
    {
      "id": "handler_writer",
      "from": "handler",
      "to": "writerContract",
      "kind": "dependency",
      "label": "寫檔函式內 WriteAsync"
    },
    {
      "id": "handler_audited",
      "from": "handler",
      "to": "auditedContract",
      "kind": "dependency",
      "label": "WriteAuditedAsync"
    },
    {
      "id": "facts_contract",
      "from": "facts",
      "to": "factsContract",
      "kind": "realization"
    },
    {
      "id": "writer_contract",
      "from": "writer",
      "to": "writerContract",
      "kind": "realization"
    },
    {
      "id": "audited_contract",
      "from": "audited",
      "to": "publishContract",
      "kind": "realization"
    },
    {
      "id": "files_contract",
      "from": "files",
      "to": "publishContract",
      "kind": "realization"
    },
    {
      "id": "root_audited",
      "from": "root",
      "to": "audited",
      "kind": "dependency",
      "label": "建立"
    },
    {
      "id": "root_files",
      "from": "root",
      "to": "files",
      "kind": "dependency",
      "label": "建立"
    },
    {
      "id": "root_facts",
      "from": "root",
      "to": "facts",
      "kind": "dependency",
      "label": "建立"
    },
    {
      "id": "audited_auditedContract",
      "from": "audited",
      "to": "auditedContract",
      "kind": "realization"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "規劃、寫檔與紀錄分工",
      "items": [
        "ExportWorkingPaperStreamHandler 透過介面取得資料、產生底稿並發布。ProjectReportStore 寫檔，AuditedReportStore 記錄發布。",
        "存檔類別支援 IAuditedReportPublishingStore 時，回應才包含操作紀錄失敗的提醒；否則使用其他發布介面。"
      ]
    },
    {
      "dot": "slate",
      "title": "圖中省略的部分",
      "items": [
        "兩個存檔類別也實作 IReportStore，負責清單、路徑與失效標記。",
        "寫檔函式與操作紀錄的呼叫順序見循序圖；圖中建立關係說明兩個存檔類別如何組合。"
      ]
    }
  ]
}
