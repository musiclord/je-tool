// JET 架構模型。來源版本與對照位置保留在交付目錄的 manifest.json 與 evidence/。
specification {
  element person { style { shape person color amber } }
  element system { style { color blue } }
  element app { style { color blue } }
  element component { style { color blue } }
  element contract { style { color secondary border dashed } }
  element store { style { shape storage color green } }
  element artifact { style { shape document color muted } }
  element external { style { color muted border dashed } }
  deploymentNode workstation { style { color muted } }
  deploymentNode folder { style { color green } }
  relationship calls { line solid color gray }
  relationship viaInterface { line dashed color sky }
  relationship indirect { line dashed color amber }
  relationship implements { line dotted color secondary head onormal }
  relationship injects { line dotted color amber head odiamond }
  relationship data { line solid color green }
  relationship uses { line solid color muted }
}

model {
  auditor = person '審計員' {
    description '以一般使用者權限操作 JET。'
    link ../evidence.html#f-environment '環境限制與來源'
  }
  inputs = artifact '來源檔案' {
    description '總帳、試算表與參考資料，可使用 xlsx、xls、CSV 或 Access。'
    link ../evidence.html#f-tb-import '匯入流程證據'
  }
  reports = artifact '報告與正式工作底稿' {
    technology '報告檔 · 報告清單'
    description '報告寫在案件資料夾。正式底稿每次另存新版本，保留同名舊檔。'
    link ../evidence.html#f-workpaper '檔案發布證據'
  }
  webview2 = external 'WebView2 執行階段' {
    description '電腦需先具備 WebView2 執行階段。'
    link ../evidence.html#f-deployment '部署前提'
  }
  ace = external 'x64 ACE 16' {
    description '只有讀取 Access 檔時需要。'
    link ../evidence.html#f-deployment '部署前提'
  }

  jet = system 'JET 審計工具' {
    description 'Windows 桌面程式，C# 與 .NET 10，WinForms 承載 WebView2 畫面。'
    link ../evidence.html#f-architecture '架構來源與快照識別'

    desktop = app 'JET 桌面程序' {
      technology 'C# · .NET 10 · WinForms · WebView2'
      description '畫面與 C# 程式在同一個桌面程序中，各層分工處理。'

      ui = component 'WebView2 畫面' {
        technology 'HTML · JavaScript · JetApi'
        description '呈現資料並接收操作，再用 action 名稱將要求交給 C#。'
        link ../evidence.html#f-bridge '跨語言通道證據'
      }
      bridge = component 'Action 通道' {
        technology 'JetWebMessageBridge · ActionDispatcher'
        description '接收畫面訊息，依 action 名稱找到處理類別。'
        link ../evidence.html#f-bridge '訊息、字串與註冊的核對'
      }
      application = component 'Application 應用流程' {
        description '安排每項操作的檢查、執行與回應。'
        link ../evidence.html#f-filter-save '篩選儲存流程'
      }
      audit = component 'AuditCore 與 Domain' {
        description '規劃審計計算、整理結果，並定義資料修改後哪些結果需要重算。'
        link ../evidence.html#f-tb-policy '失效政策'
      }
      persistence = component '資料庫實作' {
        technology 'SQLite 與 DuckDB 共用'
        description '使用 SQL 處理案件資料，也負責 project.json。SQL Server 開發暫緩。'
        link ../evidence.html#f-filter-commit 'SQL 與交易證據'
      }
      fileio = component '檔案讀寫與底稿發布' {
        description '逐列讀取來源檔；產生工作簿時先寫暫存檔，再改名並更新報告清單。'
        link ../evidence.html#f-workpaper '發布與失敗處理'
      }
      composition = component '啟動時建立物件' {
        technology 'AppCompositionRoot'
        description '啟動時建立並組合操作、資料庫與檔案元件。'
        link ../evidence.html#f-composition '建立位置的證據'
      }

      ui -[indirect]-> bridge 'WebMessage：action 與資料' {
        metadata { evidence 'L01' }
      }
      bridge -[viaInterface]-> application '依 action 名稱呼叫 HandleAsync' {
        metadata { evidence 'L02' }
      }
      application -[calls]-> audit 'JetAuditProgram.Plan 與 Finalize' {
        metadata { evidence 'L03' }
      }
      application -[viaInterface]-> persistence '透過介面讀寫資料庫' {
        metadata { evidence 'L04' }
      }
      application -[viaInterface]-> fileio '透過介面讀檔與寫報告' {
        metadata { evidence 'L05' }
      }
      persistence -[calls]-> audit 'AuditDependencyPolicy.For' {
        metadata { evidence 'L06' }
      }
      composition -[injects]-> bridge '建立 ActionDispatcher' {
        metadata { evidence 'L07' }
      }
      composition -[injects]-> application '建立各 action 的處理類別' {
        metadata { evidence 'L13' }
      }
      composition -[injects]-> persistence '建立 SQLite 與 DuckDB 的實作' {
        metadata { evidence 'L08' }
      }
      composition -[injects]-> fileio '建立讀檔器與報告存檔類別' {
        metadata { evidence 'L09' }
      }
    }

    caseData = store '案件資料庫' {
      technology 'SQLite：jet.db · DuckDB：jet.duckdb'
      description '保存案件資料，畫面按需讀取摘要與分頁。'
      link ../evidence.html#f-storage '案件資料與檔名'
    }
    projectJson = store '案件進度檔' {
      technology 'project.json'
      description '案件的步驟進度與設定，和案件資料庫放在同一個案件資料夾。'
      link ../evidence.html#f-storage '案件資料與移轉前提'
    }

    desktop.persistence -[data]-> caseData '集合式 SQL' {
      metadata { evidence 'L10' }
    }
    desktop.persistence -[data]-> projectJson 'project.json' {
      metadata { evidence 'L11' }
    }
  }

  jet.desktop.fileio -[data]-> reports '發布報告檔' {
    metadata { evidence 'L12' }
  }

  auditor -[uses]-> jet.desktop.ui '操作' {
    metadata { evidence 'C01' }
  }
  inputs -[data]-> jet.desktop.fileio '讀取來源檔' {
    metadata { evidence 'C02' }
  }
  reports -[uses]-> auditor '檢視與使用' {
    metadata { evidence 'C03' }
  }
  jet.desktop -[uses]-> webview2 '承載畫面' {
    metadata { evidence 'C04' }
  }
  jet.desktop.fileio -[uses]-> ace '讀 Access 檔' {
    metadata { evidence 'C05' }
  }

  filterSlice = component '篩選情境儲存的類別' {
    description '處理 filter.scenario.save 的類別與介面，以 SQLite 或 DuckDB 案件為準。'
    link ../archify/filter-types/filter-types.html '詳細類別與介面圖'

    jetapi = component 'JetApi' { technology 'JavaScript' }
    bridge = component 'JetWebMessageBridge'
    dispatcher = component 'ActionDispatcher'
    handlerContract = contract 'IApplicationActionHandler' { technology 'interface' }
    handler = component 'FilterScenarioSaveHandler'
    batch = component 'FilterScenarioBatchWriter' { technology 'internal static' }
    program = component 'JetAuditProgram' { technology 'static' }
    factsContract = contract 'IFilterFactsPort' { technology 'interface' }
    facts = component 'FilterFactsPort'
    commitContract = contract 'IFilterCommitRepository' { technology 'interface' }
    commit = component 'LocalFilterCommitRepository'
    storeContract = contract 'IFilterScenarioStore' { technology 'interface' }
    store = component 'LocalFilterScenarioStore'
    root = component 'AppCompositionRoot'
    db = store '案件資料庫' { technology 'SQLite 或 DuckDB' }

    jetapi -[indirect]-> bridge 'filter.scenario.save' {
      metadata { evidence 'F01' }
    }
    bridge -[calls]-> dispatcher 'DispatchAsync' {
      metadata { evidence 'F02' }
    }
    dispatcher -[viaInterface]-> handlerContract 'HandleAsync' {
      metadata { evidence 'F03' }
    }
    handler -[implements]-> handlerContract '實作' {
      metadata { evidence 'F04' }
    }
    handler -[calls]-> batch 'LoadAsync、PlanSave、PublishAsync' {
      metadata { evidence 'F05' }
    }
    handler -[viaInterface]-> storeContract 'ListAsync' {
      metadata { evidence 'F06' }
    }
    batch -[calls]-> program 'Plan、PlanOneScenario、Finalize' {
      metadata { evidence 'F07' }
    }
    batch -[viaInterface]-> factsContract 'ExecuteAsync：只存一個或整批合格' {
      metadata { evidence 'F08' }
    }
    batch -[viaInterface]-> storeContract 'ReplaceAllAsync：有不合格' {
      metadata { evidence 'F09' }
    }
    facts -[implements]-> factsContract '實作' {
      metadata { evidence 'F10' }
    }
    facts -[viaInterface]-> commitContract 'CommitAsync、SaveOneAsync' {
      metadata { evidence 'F11' }
    }
    commit -[implements]-> commitContract '實作' {
      metadata { evidence 'F12' }
    }
    store -[implements]-> storeContract '實作' {
      metadata { evidence 'F13' }
    }
    root -[injects]-> handler '建立' {
      metadata { evidence 'F14' }
    }
    root -[injects]-> facts '建立' {
      metadata { evidence 'F15' }
    }
    root -[injects]-> commit '建立' {
      metadata { evidence 'F16' }
    }
    root -[injects]-> store '建立' {
      metadata { evidence 'F17' }
    }
    commit -[data]-> db '同一筆交易寫定義並算出命中' {
      metadata { evidence 'F18' }
    }
    store -[data]-> db '同一筆交易只寫定義並清除命中' {
      metadata { evidence 'F19' }
    }
  }

  tbSlice = component 'TB 取代匯入的類別' {
    description '處理 import.tb.fromFile 的類別與介面，以 SQLite 或 DuckDB 案件為準。'
    link ../archify/import-classes/import-classes.html '詳細類別與介面圖'

    handler = component 'ImportTbFromFileHandler' { technology '流程寫在父類別 ImportFromFileHandler' }
    program = component 'JetAuditProgram' { technology 'static' }
    readerContract = contract 'ITabularFileReader' { technology 'interface' }
    reader = component 'CompositeTabularFileReader'
    intakeContract = contract 'IIntakeFactsPort' { technology 'interface' }
    intake = component 'IntakeFactsPort'
    importContract = contract 'IImportRepository' { technology 'interface' }
    importRepository = component 'LocalImportRepository'
    projectContract = contract 'IProjectStore' { technology 'interface' }
    project = component 'JsonFileProjectStore'
    root = component 'AppCompositionRoot'
    db = store '案件資料庫' { technology 'SQLite 或 DuckDB' }
    projectFile = store '案件進度檔' { technology 'project.json' }

    handler -[calls]-> program 'Plan、Finalize' {
      metadata { evidence 'T01' }
    }
    handler -[viaInterface]-> importContract 'GetLatestBatchAsync' {
      metadata { evidence 'T02' }
    }
    handler -[viaInterface]-> readerContract 'ReadColumnsAsync、ReadRowsAsync' {
      metadata { evidence 'T03' }
    }
    handler -[viaInterface]-> intakeContract 'ExecuteAsync' {
      metadata { evidence 'T04' }
    }
    handler -[viaInterface]-> projectContract 'SaveAsync：提交後推進步驟' {
      metadata { evidence 'T05' }
    }
    intake -[viaInterface]-> importContract 'ReplaceBatchAsync' {
      metadata { evidence 'T06' }
    }
    reader -[implements]-> readerContract '實作' {
      metadata { evidence 'T07' }
    }
    intake -[implements]-> intakeContract '實作' {
      metadata { evidence 'T08' }
    }
    importRepository -[implements]-> importContract '實作' {
      metadata { evidence 'T09' }
    }
    project -[implements]-> projectContract '實作' {
      metadata { evidence 'T10' }
    }
    root -[injects]-> handler '建立' {
      metadata { evidence 'T11' }
    }
    root -[injects]-> reader '建立' {
      metadata { evidence 'T12' }
    }
    root -[injects]-> intake '建立' {
      metadata { evidence 'T13' }
    }
    root -[injects]-> importRepository '建立' {
      metadata { evidence 'T14' }
    }
    root -[injects]-> project '建立' {
      metadata { evidence 'T15' }
    }
    importRepository -[indirect]-> reader '逐列取用準備好的資料列' {
      metadata { evidence 'T16' }
    }
    importRepository -[data]-> db '同一筆交易取代批次與資料列' {
      metadata { evidence 'T17' }
    }
    project -[data]-> projectFile 'project.json' {
      metadata { evidence 'T18' }
    }
  }

  paperSlice = component '正式底稿匯出的類別' {
    description '處理 export.workingPaperStream 的類別與介面，以 SQLite 或 DuckDB 案件為準。'
    link ../archify/export-classes/export-classes.html '詳細類別與介面圖'

    handler = component 'ExportWorkingPaperStreamHandler'
    materialize = component 'FilterHitMaterializeService'
    program = component 'JetAuditProgram' { technology 'static' }
    factsContract = contract 'IWorkingPaperPlanningFactsPort' { technology 'interface' }
    facts = component 'WorkingPaperPlanningFactsPort'
    writerContract = contract 'IWorkingPaperPlanWriter' { technology 'interface' }
    writer = component 'WorkingPaperWriter'
    auditedContract = contract 'IAuditedReportPublishingStore' { technology 'interface' }
    audited = component 'AuditedReportStore'
    publishContract = contract 'IReportPublishingStore' { technology 'interface' }
    files = component 'ProjectReportStore'
    root = component 'AppCompositionRoot'
    folder = artifact '案件資料夾的報告檔' { technology '底稿檔 · reports.json' }

    handler -[calls]-> materialize 'RequireUsableAsync、MaterializeSelectedAsync' {
      metadata { evidence 'W01' }
    }
    handler -[calls]-> program 'Plan、Finalize' {
      metadata { evidence 'W02' }
    }
    handler -[viaInterface]-> factsContract 'ExecuteAsync' {
      metadata { evidence 'W03' }
    }
    handler -[viaInterface]-> auditedContract 'WriteAuditedAsync' {
      metadata { evidence 'W04' }
    }
    audited -[viaInterface]-> publishContract 'WriteWithPublishingAsync' {
      metadata { evidence 'W05' }
    }
    handler -[viaInterface]-> writerContract 'WriteAsync：寫檔函式內' {
      metadata { evidence 'W06' }
    }
    facts -[implements]-> factsContract '實作' {
      metadata { evidence 'W07' }
    }
    writer -[implements]-> writerContract '實作' {
      metadata { evidence 'W08' }
    }
    audited -[implements]-> auditedContract '實作' {
      metadata { evidence 'W09' }
    }
    files -[implements]-> publishContract '實作' {
      metadata { evidence 'W10' }
    }
    root -[injects]-> facts '建立' {
      metadata { evidence 'W11' }
    }
    root -[injects]-> audited '建立' {
      metadata { evidence 'W12' }
    }
    root -[injects]-> files '建立' {
      metadata { evidence 'W13' }
    }
    root -[injects]-> writer '建立' {
      metadata { evidence 'W14' }
    }
    files -[indirect]-> handler '執行事先交出的寫檔函式' {
      metadata { evidence 'W15' }
    }
    files -[data]-> folder '寫暫存檔、改名並更新報告清單' {
      metadata { evidence 'W16' }
    }
  }
}

views {
  view index {
    title 'JET 的使用者與外部資料'
    description '先認識誰使用 JET、資料從哪裡來，以及產出哪些檔案。'
    include auditor, inputs, jet, reports, webview2, ace
    autoLayout LeftRight
  }

  view containers of jet {
    title '程式與案件資料放在哪裡'
    description 'JET 在本機執行，案件資料庫、設定與報告放在案件資料夾。'
    include auditor, inputs, jet.desktop, jet.caseData, jet.projectJson, reports, webview2
    autoLayout LeftRight
  }

  view components of jet.desktop {
    title '程式各部分如何分工'
    description '從畫面操作，看到處理流程、審計規則、資料庫與檔案讀寫的分工。'
    include jet.desktop.*, jet.caseData, jet.projectJson, inputs, reports
    exclude jet.desktop.composition
    style * { size small textSize large }
    rank same { jet.desktop.audit, jet.desktop.persistence, jet.desktop.fileio }
    autoLayout TopBottom 40 80
  }

  view assembly of jet.desktop {
    title '啟動時如何組合程式'
    description 'AppCompositionRoot 建立所需元件，再把它們交給各處理類別。點線表示建立關係。'
    include jet.desktop.composition, jet.desktop.bridge, jet.desktop.application, jet.desktop.persistence, jet.desktop.fileio
    exclude jet.desktop.bridge -> jet.desktop.application, jet.desktop.application -> jet.desktop.persistence, jet.desktop.application -> jet.desktop.fileio
    style * { size small textSize large }
    rank same { jet.desktop.bridge, jet.desktop.application, jet.desktop.persistence, jet.desktop.fileio }
    autoLayout TopBottom 60 150
  }

  view filterComponents of filterSlice {
    title '篩選情境的類別分工'
    description '查看儲存流程使用哪些介面，以及啟動時建立哪個實作類別。'
    link ../archify/filter-types/filter-types.html '詳細類別與介面圖'
    include filterSlice.*
    rank same { filterSlice.handlerContract, filterSlice.factsContract, filterSlice.commitContract, filterSlice.storeContract }
    rank same { filterSlice.facts, filterSlice.commit, filterSlice.store }
    rank sink { filterSlice.db }
    autoLayout TopBottom 40 70
  }

  dynamic view filterSave {
    title '儲存單一情境的處理順序'
    description '其他情境合格、符合目前規則且結果未過期時，只取代本次情境。整批處理另見完整循序圖。'
    link ../archify/action-sequence/action-sequence.html '三個分支的循序圖'
    variant diagram
    autoLayout LeftRight 40 80
    filterSlice.handler -> filterSlice.batch 'LoadAsync' {
      notes '要求目前驗證結果與 GL 配對；不符就回錯誤，不寫入。'
    }
    filterSlice.handler -> filterSlice.store 'IFilterScenarioStore.ListAsync'
    filterSlice.handler -> filterSlice.batch 'PlanSave' {
      notes '只檢查本次情境。'
    }
    filterSlice.handler -> filterSlice.batch 'PublishAsync' {
      notes '先讀存好的結果是否過期，再由 PlanWrite 決定寫法；以下是只存一個情境的分支。'
    }
    filterSlice.batch -> filterSlice.program 'PlanOneScenario'
    filterSlice.batch -> filterSlice.facts 'IFilterFactsPort.ExecuteAsync' {
      notes '透過介面呼叫；實際是 FilterFactsPort。'
    }
    filterSlice.facts -> filterSlice.commit 'IFilterCommitRepository.SaveOneAsync' {
      notes '透過介面呼叫；SQLite 與 DuckDB 案件實際是 LocalFilterCommitRepository。'
    }
    filterSlice.commit -> filterSlice.db '同一筆交易只換這個情境的定義與命中'
    filterSlice.batch -> filterSlice.program 'Finalize'
    filterSlice.handler <- filterSlice.batch '情境、命中版本與失效狀態' {
      notes '提交後讀回，這時不再接受取消。'
    }
  }

  dynamic view tbImport {
    title '取代匯入 TB 的處理順序'
    description '從讀檔到完成寫入。操作紀錄與失敗處理另見完整循序圖及流程圖。'
    link ../archify/import-sequence/import-sequence.html 'TB 取代匯入的循序圖'
    variant diagram
    autoLayout LeftRight 40 80
    tbSlice.handler -> tbSlice.importRepository 'IImportRepository.GetLatestBatchAsync' {
      notes '先由 JetAuditProgram 建立計畫，再讀前一批次。'
    }
    tbSlice.handler -> tbSlice.reader 'ITabularFileReader.ReadColumnsAsync' {
      notes '逐一讀完所有來源的標頭；任一失敗就不寫入。'
    }
    tbSlice.handler -> tbSlice.reader 'ITabularFileReader.ReadRowsAsync' {
      notes '先準備讀取方式，還沒讀資料列。'
    }
    tbSlice.handler -> tbSlice.intake 'IIntakeFactsPort.ExecuteAsync' {
      notes '在背景執行。'
    }
    tbSlice.intake -> tbSlice.importRepository 'IImportRepository.ReplaceBatchAsync' {
      notes '透過介面呼叫；SQLite 與 DuckDB 案件實際是 LocalImportRepository。'
    }
    tbSlice.importRepository -> tbSlice.reader '逐列取用準備好的資料列'
    tbSlice.importRepository -> tbSlice.db '同一筆交易取代批次與資料列'
    tbSlice.handler -> tbSlice.project 'IProjectStore.SaveAsync' {
      notes '提交之後，案件步驟落後才更新；這時不再接受取消。'
    }
  }

  dynamic view workingPaperExport {
    title '匯出正式底稿的處理順序'
    description '呈現正常完成匯出的路徑。發布失敗時的還原方式另見流程圖。'
    link ../archify/workpaper-sequence/workpaper-sequence.html '正式底稿匯出的循序圖'
    variant diagram
    style * { size large textSize medium }
    autoLayout LeftRight 40 80
    paperSlice.handler -> paperSlice.materialize 'RequireUsableAsync' {
      notes '核對版本之後；結果過期時改呼叫 MaterializeSelectedAsync，只重算選取的情境。'
    }
    paperSlice.handler -> paperSlice.facts 'IWorkingPaperPlanningFactsPort.ExecuteAsync' {
      notes '先由 JetAuditProgram 建立計畫；只讀規劃需要的資料。'
    }
    paperSlice.handler -> paperSlice.audited 'IAuditedReportPublishingStore.WriteAuditedAsync' {
      notes '先數既有報告，再交給下一層寫檔。'
    }
    paperSlice.audited -> paperSlice.files 'IReportPublishingStore.WriteWithPublishingAsync'
    paperSlice.files -> paperSlice.handler '執行事先交出的寫檔函式'
    paperSlice.handler -> paperSlice.writer 'IWorkingPaperPlanWriter.WriteAsync' {
      notes '依計畫分頁讀資料列，寫進暫存檔。'
    }
    paperSlice.files -> paperSlice.folder '改名成正式檔名並更新報告清單'
    paperSlice.handler <- paperSlice.audited 'Report' {
      notes '發布成功後寫操作紀錄；寫入失敗時回應附提醒。'
    }
  }

  deployment view localRuntime {
    title '電腦上的程式與檔案'
    description 'Windows 電腦需具備 WebView2；讀 Access 時另需 ACE。公司環境仍待部署確認。SQL Server 暫緩開發。'
    include *, local.caseFolder.*
    style * { size small textSize large }
    autoLayout LeftRight 40 80
  }
}

deployment {
  workstation local 'Windows 工作站' {
    description '使用一般權限執行 JET，不需要外部 AI 服務。'
    folder release '發布資料夾' {
      description 'JET.exe、設定、範本與 wwwroot 要一起交付。'
      instanceOf jet.desktop
    }
    folder caseFolder '案件資料夾' {
      description '使用者可寫入的位置；移轉時先正常離開 JET，再複製整個資料夾。'
      instanceOf jet.caseData
      instanceOf jet.projectJson
      instanceOf reports
    }
    instanceOf webview2
    instanceOf ace
    instanceOf inputs
  }
}
