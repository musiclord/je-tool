{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "TB 取代匯入：串流、交易與步驟更新",
    "locale": "zh-TW",
    "output": "output/import-sequence/import-sequence.html",
    "quality_profile": "showcase"
  },
  "cards": [
    {
      "dot": "cyan",
      "title": "流程與界線",
      "items": [
        "LocalImportRepository 透過來源串流回呼讀檔；圖中這條線表示串流消費，並非直接呼叫 FileReader 的類別方法。",
        "TB 取代匯入會清除依賴的結果、情境與科目配對；分類定義及 GL 控制總數保留。",
        "交易失敗會嘗試回復並保存回復失敗的診斷；不能把它寫成所有故障都一定回復。",
        "步驟保存失敗只記警告，已提交的匯入不因此撤回；這不是必定更新成功的保證。"
      ]
    },
    {
      "dot": "slate",
      "title": "閱讀方式",
      "items": [
        "這是來源快照的靜態整理，沒有執行 JET 業務流程。",
        "完整來源、檔案雜湊及選取的呼叫，可從本輪離線入口的證據頁查閱。"
      ]
    }
  ],
  "participants": [
    {
      "id": "ui",
      "label": "JetApi",
      "type": "frontend",
      "sublabel": "importTbFromFile"
    },
    {
      "id": "route",
      "label": "Action 通道",
      "type": "backend",
      "sublabel": "Bridge 與 Dispatcher"
    },
    {
      "id": "handler",
      "label": "ImportHandler",
      "type": "backend",
      "sublabel": "ImportFromFileHandler"
    },
    {
      "id": "reader",
      "label": "FileReader",
      "type": "external",
      "sublabel": "ITabularFileReader"
    },
    {
      "id": "port",
      "label": "IntakeFactsPort",
      "type": "backend",
      "sublabel": "IIntakeFactsPort"
    },
    {
      "id": "repo",
      "label": "LocalImport",
      "type": "database",
      "sublabel": "LocalImportRepository"
    },
    {
      "id": "project",
      "label": "ProjectStore",
      "type": "database",
      "sublabel": "IProjectStore"
    }
  ],
  "messages": [
    {
      "id": "message1",
      "from": "ui",
      "to": "route",
      "y": 168,
      "label": "import.tb.fromFile",
      "note": "本圖選 mode=replace；payload 不含完整資料列"
    },
    {
      "id": "message2",
      "from": "route",
      "to": "handler",
      "y": 233,
      "label": "HandleAsync",
      "note": "ImportTbFromFileHandler 使用共用實作"
    },
    {
      "id": "message3",
      "from": "handler",
      "to": "reader",
      "y": 298,
      "label": "ReadColumnsAsync",
      "note": "所有來源標頭先讀完，再交付資料串流"
    },
    {
      "id": "message4",
      "from": "reader",
      "to": "handler",
      "y": 363,
      "label": "有界欄位清單",
      "variant": "return"
    },
    {
      "id": "message5",
      "from": "handler",
      "to": "port",
      "y": 403,
      "label": "ExecuteAsync",
      "note": "IntakePlan 與延遲讀取的來源串流"
    },
    {
      "id": "message6",
      "from": "port",
      "to": "repo",
      "y": 468,
      "label": "ReplaceBatchAsync",
      "note": "取代批次、配對與依賴結果在同一交易"
    },
    {
      "id": "message7",
      "from": "repo",
      "to": "reader",
      "y": 533,
      "label": "列舉資料串流",
      "note": "經 handler 包裝的 IAsyncEnumerable 逐列讀取"
    },
    {
      "id": "message8",
      "from": "reader",
      "to": "repo",
      "y": 606,
      "label": "StagingRow",
      "note": "每 20,000 列的事件只提供進度提示",
      "variant": "return"
    },
    {
      "id": "message9",
      "from": "repo",
      "to": "port",
      "y": 671,
      "label": "ImportBatchResult",
      "note": "提交前檢查取消；提交使用 None",
      "variant": "return"
    },
    {
      "id": "message10",
      "from": "port",
      "to": "handler",
      "y": 736,
      "label": "IntakeFacts",
      "variant": "return"
    },
    {
      "id": "message11",
      "from": "handler",
      "to": "project",
      "y": 776,
      "label": "FindAsync / SaveAsync",
      "note": "僅步驟落後時儲存；使用 None"
    },
    {
      "id": "message12",
      "from": "handler",
      "to": "route",
      "y": 841,
      "label": "批次摘要與失效狀態",
      "note": "取代時另寫最小審計留痕",
      "variant": "return"
    },
    {
      "id": "message13",
      "from": "route",
      "to": "ui",
      "y": 906,
      "label": "操作完成回應",
      "note": "完成以 action 回應為準",
      "variant": "return"
    }
  ]
