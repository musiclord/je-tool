      "type": "database",
      "stage": 2,
      "row": 2,
      "sublabel": "result_filter_run"
    },
    {
      "id": "screen",
      "label": "畫面查詢",
      "type": "frontend",
      "stage": 3,
      "row": 0,
      "sublabel": "摘要與有界分頁"
    },
    {
      "id": "workbook",
      "label": "工作底稿",
      "type": "external",
      "stage": 3,
      "row": 2,
      "sublabel": "writer 串流輸出"
    }
  ],
  "flows": [
    {
      "id": "flow1",
      "from": "population",
      "to": "validation",
      "label": "標準化資料"
    },
    {
      "id": "flow2",
      "from": "conditions",
      "to": "filter",
      "label": "條件定義"
    },
    {
      "id": "flow3",
      "from": "population",
      "to": "filter",
