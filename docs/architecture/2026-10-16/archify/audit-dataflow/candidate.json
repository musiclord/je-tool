{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "審計計算、畫面查詢與報告資料",
    "locale": "zh-TW",
    "output": "output/audit-dataflow/audit-dataflow.html",
    "quality_profile": "showcase"
  },
  "cards": [
    {
      "dot": "cyan",
      "title": "資料範圍",
      "items": [
        "正式底稿還讀取來源欄位定義、配對及範本；圖只聚焦主要審計資料。",
        "WorkpaperPlanningFactsPort 讀取有界存在性及計數，writer 另行串流取得完整明細。",
        "圖上連線代表資料依賴；執行先後與例外請看循序圖及第一輪業務流程圖。"
      ]
    },
    {
      "dot": "slate",
      "title": "閱讀方式",
      "items": [
        "這是來源快照的靜態整理，沒有執行 JET 業務流程。",
        "完整來源、檔案雜湊及選取的呼叫，可從本輪離線入口的證據頁查閱。"
      ]
    }
  ],
  "stages": [
    {
      "label": "資料庫輸入"
    },
    {
      "label": "集合式計算"
    },
    {
      "label": "已保存結果"
    },
    {
      "label": "使用方式"
    }
  ],
  "nodes": [
    {
      "id": "population",
