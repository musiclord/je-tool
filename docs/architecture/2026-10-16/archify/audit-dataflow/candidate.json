      "type": "database",
      "stage": 0,
      "row": 2,
      "sublabel": "config_filter_scenario"
    },
    {
      "id": "validation",
      "label": "驗證與預篩選",
      "type": "backend",
      "stage": 1,
      "row": 0,
      "sublabel": "共用規則與 SQL"
    },
    {
      "id": "filter",
      "label": "進階篩選",
      "type": "backend",
      "stage": 1,
      "row": 2,
      "sublabel": "條件樹轉 SQL"
    },
    {
      "id": "summary",
      "label": "執行摘要",
      "type": "database",
      "stage": 2,
      "row": 0,
