  "cards": [
    {
      "dot": "cyan",
      "title": "這些線代表什麼",
      "items": [
        "實現線由實作類別指向介面。依賴線表示已讀取程式中的使用關係。",
        "方法區只選列本次流程用到的名稱；完整簽章保留在 Roslyn 原始結果。",
        "介面宣告是編譯時目標。實際使用哪個 repository，要核對作用中案件與組裝。"
      ]
    },
    {
      "dot": "emerald",
      "title": "本機路徑的組裝",
      "items": [
        "AppCompositionRoot.Repositories.cs 第 56–62 與 129–137 行，把 LocalFilterCommitRepository 注入 FilterFactsPort。",
        "FilterFactsPort.cs 第 20–25 與 44–55 行，將儲存 action 導向 CommitAsync。",
        "SQL Server 類別展示程式結構，本次沒有啟動或驗證 SQL Server。"
      ]
    },
    {
      "dot": "amber",
      "title": "來源與驗證範圍",
      "items": [
        "本圖使用未提交內容的固定快照。證據頁 filter-facts、filter-commit 與 relation-comparison.json 可回查。",
        "來源以 SHA-256 與行號核對，未使用 Archify 只認已提交版本的 Git 來源驗證。",
        "圖表檢查不證明業務流程已執行。C# internal 沒有改標成 UML package。"
      ]
    }
  ]
