{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "試算表取代匯入：資料修改與交易",
    "locale": "zh-TW",
    "output": "output/archify/tb-import/tb-import.html",
    "quality_profile": "showcase",
    "legend": {
      "mode": "auto",
      "entries": {
        "backend": {
          "label": "應用程式處理"
        },
        "frontend": {
          "label": "操作與回應"
        },
        "database": {
          "label": "資料庫操作"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "request",
      "label": "操作與讀檔"
    },
    {
      "id": "transaction",
      "label": "同一資料庫交易"
    },
    {
      "id": "complete",
      "label": "提交後"
    },
    {
      "id": "failure",
      "label": "取消或失敗"
    }
  ],
  "nodes": [
    {
      "id": "request",
      "lane": "request",
      "col": 0,
      "label": "取代試算表",
      "type": "frontend",
      "sublabel": "import.tb.fromFile"
    },
    {
      "id": "plan",
      "lane": "request",
      "col": 1,
      "label": "解析匯入計畫",
      "type": "backend",
      "sublabel": "Replace 與 DatasetKind.Tb"
    },
    {
      "id": "headers",
      "lane": "request",
      "col": 2,
      "label": "先讀所有標頭",
      "type": "backend",
      "sublabel": "再提供資料列串流"
    },
    {
      "id": "begin",
      "lane": "transaction",
      "col": 2,
      "label": "開始本機交易",
      "type": "backend",
      "sublabel": "LocalImportRepository"
    },
    {
      "id": "clear",
      "lane": "transaction",
      "col": 3,
      "label": "清除舊資料與下游",
      "type": "database",
      "sublabel": "失效範圍由 Domain 決定"
    },
    {
      "id": "write",
      "lane": "transaction",
      "col": 4,
      "label": "寫入新批次",
      "type": "database",
      "sublabel": "資料串流與欄位定義"
    },
    {
      "id": "commit",
      "lane": "transaction",
      "col": 5,
      "label": "提交交易",
      "type": "backend",
      "sublabel": "提交前檢查取消"
    },
    {
      "id": "metadata",
      "lane": "complete",
      "col": 5,
      "label": "更新步驟與回應",
      "type": "backend",
      "sublabel": "保留已提交的結果"
    },
    {
      "id": "rollback",
      "lane": "failure",
      "col": 3,
      "label": "嘗試回復交易",
      "type": "backend",
      "sublabel": "記錄回復失敗"
    },
    {
      "id": "error",
      "lane": "failure",
      "col": 5,
      "label": "回報失敗或取消",
      "type": "frontend",
      "sublabel": "讓使用者確認後重試"
    }
  ],
  "edges": [
    {
      "id": "request_plan",
      "from": "request",
      "to": "plan"
    },
    {
      "id": "plan_headers",
      "from": "plan",
      "to": "headers"
    },
    {
      "id": "headers_begin",
      "from": "headers",
      "to": "begin"
    },
    {
      "id": "begin_clear",
      "from": "begin",
      "to": "clear"
    },
    {
      "id": "clear_write",
      "from": "clear",
      "to": "write"
    },
    {
      "id": "write_commit",
      "from": "write",
      "to": "commit"
    },
    {
      "id": "commit_metadata",
      "from": "commit",
      "to": "metadata"
    },
    {
      "id": "headers_error",
      "from": "headers",
      "to": "error",
      "label": "讀檔失敗",
      "role": "error"
    },
    {
      "id": "clear_rollback",
      "from": "clear",
      "to": "rollback",
      "label": "例外",
      "role": "error"
    },
    {
      "id": "write_rollback",
      "from": "write",
      "to": "rollback",
      "label": "取消或例外",
      "role": "error"
    },
    {
      "id": "rollback_error",
      "from": "rollback",
      "to": "error"
    }
  ],
  "mainPath": [
    "request",
    "plan",
    "headers",
    "begin",
    "clear",
    "write",
    "commit",
    "metadata"
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "TB 修改的影響",
      "items": [
        "清除科目配對、驗證、預篩選、篩選命中及全部已存情境定義。",
        "保留分類定義與 GL 控制總數。圖中是取代匯入；追加模式不在這份切片。"
      ]
    },
    {
      "dot": "amber",
      "title": "提交界線",
      "items": [
        "資料庫修改在同一交易中；提交前的取消會進入回復。",
        "提交完成後，更新流程步驟不再接受該次取消。資料庫交易不包含所有後續檔案或介面回應。",
        "沒有把程式中的回復處理宣稱成斷電或任何故障都能完整復原。"
      ]
    },
    {
      "dot": "emerald",
      "title": "來源核對",
      "items": [
        "ImportFromFileHandler.cs 第 43–197、480–494 行；IntakeFactsPort.cs 第 10–35 行。",
        "LocalImportRepository.cs 第 30–90、189–234 行；AuditDependencyPolicy.cs 第 40–65 行；RuleRunResultReset.cs 第 30–98 行。",
        "完整相對路徑與 SHA-256 見證據頁 tb-import、tb-transaction、tb-policy。本次未執行匯入或真實資料驗收。"
      ]
    }
  ]
}