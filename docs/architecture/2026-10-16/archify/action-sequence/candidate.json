{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "篩選儲存：前端 action 到資料庫",
    "locale": "zh-TW",
    "output": "output/action-sequence/action-sequence.html",
    "quality_profile": "showcase"
  },
  "cards": [
    {
      "dot": "cyan",
      "title": "流程與界線",
      "items": [
        "圖中主線表示整批情境合格的儲存。仍有不合格情境時，只保存定義並清除命中；第一輪業務流程圖保留完整分支。",
        "「目前驗證」指可用的驗證版本，沒有把完整性差異必須歸零當成前置條件。",
        "未預期錯誤由 Bridge 轉為固定訊息；回應成功也不是這次靜態研究執行過該操作的證據。",
        "LocalRepository 的完整類別名稱是 LocalFilterCommitRepository。",
        "提交後的步驟保存失敗只記警告，不把已完成的篩選儲存改報為失敗。"
      ]
    },
    {
      "dot": "slate",
      "title": "閱讀方式",
      "items": [
        "這是來源快照的靜態整理，沒有執行 JET 業務流程。",
        "完整來源、檔案雜湊及選取的呼叫，可從本輪離線入口的證據頁查閱。"
      ]
    }
  ],
  "participants": [
    {
      "id": "ui",
      "label": "JetApi",
      "type": "frontend",
      "sublabel": "filterScenarioSave"
    },
    {
      "id": "bridge",
      "label": "WebMessageBridge",
      "type": "backend",
      "sublabel": "JetWebMessageBridge"
    },
    {
      "id": "dispatch",
      "label": "Dispatcher",
      "type": "backend",
      "sublabel": "ActionDispatcher"
    },
    {
      "id": "handler",
      "label": "SaveHandler",
      "type": "backend",
      "sublabel": "FilterScenarioSaveHandler"
    },
    {
      "id": "batch",
      "label": "BatchWriter",
      "type": "backend",
      "sublabel": "FilterScenarioBatchWriter"
    },
    {
      "id": "facts",
      "label": "FactsPort",
      "type": "backend",
      "sublabel": "FilterFactsPort"
    },
    {
      "id": "repo",
      "label": "LocalRepository",
      "type": "database",
      "sublabel": "本機篩選交易"
    }
  ],
  "messages": [
    {
      "id": "message1",
      "from": "ui",
      "to": "bridge",
      "y": 168,
      "label": "filter.scenario.save",
      "note": "requestId、action、payload"
    },
    {
      "id": "message2",
      "from": "bridge",
      "to": "dispatch",
      "y": 233,
      "label": "DispatchAsync",
      "note": "經 RequestCancellationRegistry 管理取消"
    },
    {
      "id": "message3",
      "from": "dispatch",
      "to": "handler",
      "y": 298,
      "label": "HandleAsync",
      "note": "依註冊表選擇；變更作業取得獨占執行權"
    },
    {
      "id": "message4",
      "from": "handler",
      "to": "batch",
      "y": 363,
      "label": "LoadAsync / PlanSave",
      "note": "核對目前驗證、GL 配對及本次情境"
    },
    {
      "id": "message5",
      "from": "handler",
      "to": "batch",
      "y": 428,
      "label": "PublishAsync",
      "note": "保留其他情境；判斷整批是否合格"
    },
    {
      "id": "message6",
      "from": "batch",
      "to": "facts",
      "y": 493,
      "label": "ExecuteAsync",
      "note": "此段只表示整批合格的分支"
    },
    {
      "id": "message7",
      "from": "facts",
      "to": "repo",
      "y": 558,
      "label": "CommitAsync",
      "note": "同一交易取代定義與命中，清除失效狀態"
    },
    {
      "id": "message8",
      "from": "repo",
      "to": "facts",
      "y": 623,
      "label": "提交完成",
      "note": "提交前檢查取消；CommitAsync 使用 None",
      "variant": "return"
    },
    {
      "id": "message9",
      "from": "facts",
      "to": "batch",
      "y": 688,
      "label": "FilterFacts",
      "variant": "return"
    },
    {
      "id": "message10",
      "from": "batch",
      "to": "handler",
      "y": 728,
      "label": "權威狀態",
      "note": "必要步驟更新及讀回不受晚到取消影響",
      "variant": "return"
    },
    {
      "id": "message11",
      "from": "handler",
      "to": "dispatch",
      "y": 793,
      "label": "操作結果",
      "variant": "return"
    },
    {
      "id": "message12",
      "from": "dispatch",
      "to": "bridge",
      "y": 833,
      "label": "操作結果",
      "variant": "return"
    },
    {
      "id": "message13",
      "from": "bridge",
      "to": "ui",
      "y": 873,
      "label": "PostWebMessageAsJson",
      "note": "依 requestId 解決原 Promise",
      "variant": "return"
    }
  ]
}