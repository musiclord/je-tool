specification {
  element person { style { shape person color amber } }
  element system { style { color blue } }
  element app { style { color blue } }
  element component { style { color blue } }
  element store { style { shape storage color green } }
  element artifact { style { shape document color muted } }
  deploymentNode workstation { style { color muted } }
  deploymentNode folder { style { color green } }
}
model {
  auditor = person '審計員' {
    description '以一般使用者權限操作 JET。'
    link ../evidence.html#environment '環境限制與來源'
  }
  inputs = artifact '匯入檔案' {
    description '總帳、試算表與參考資料。這份圖沒有案件內容。'
    link ../evidence.html#tb-import '匯入流程證據'
  }
  reports = artifact '報告與正式工作底稿' {
    description 'WorkingPaper 每次匯出另建新版本。其他報告的發布政策不同。'
    link ../evidence.html#workpaper '檔案發布證據'
  }
  jet = system 'JET 審計工具' {
    description 'Windows 桌面程式。本模型由 agent 首次建立，根據未提交工作檔的固定快照核對。'
    link ../evidence.html#architecture '架構來源與快照識別'
    desktop = app 'JET 桌面應用程式' {
      technology 'C# · .NET 10 · WinForms · WebView2'
      description '畫面與 C# 應用邏輯屬於同一套桌面產品。以下分層是程式責任，並非獨立部署的網路服務。'
      ui = component 'WebView2 畫面' {
        technology 'HTML · JavaScript'
        description '負責操作與呈現。JetApi 傳送 action 與 payload，不負責審計判斷。'
        link ../evidence.html#bridge '跨語言通道證據'
      }
      bridge = component 'JetApi 通道與派送' {
        technology 'JetWebMessageBridge · ActionDispatcher'
        description '接收 WebMessage，依 action 字串找到 IApplicationActionHandler。實際 handler 需配合註冊表核對。'
        link ../evidence.html#bridge '訊息、字串與註冊的核對'
      }
      application = component 'Application 應用流程' {
        description '協調作用中案件、前置檢查、規劃、執行及回應。'
        link ../evidence.html#filter-save '篩選儲存流程'
      }
      audit = component 'AuditCore 與 Domain' {
        description 'JetAuditProgram 建立型別化計畫與結果；Domain 保存規則與資料修改的影響範圍。'
        link ../evidence.html#tb-policy '失效政策'
      }
      persistence = component '資料庫實作' {
        description '透過介面執行集合式 SQL。SQLite 和 DuckDB 共用 Local 實作。SQL Server 有程式實作，但開發目前暫緩。'
        link ../evidence.html#filter-commit 'SQL 與交易證據'
      }
      fileio = component '檔案讀寫與底稿發布' {
        description '讀取來源串流，產生工作簿，經暫存檔、重新命名與索引發布。正式底稿不覆寫同名檔。'
        link ../evidence.html#workpaper '發布及失敗處理'
      }
      ui -> bridge 'action 與 payload'
      bridge -> application '呼叫註冊的 handler'
      application -> audit '建立計畫與整理結果'
      application -> persistence '透過介面執行'
      application -> fileio '匯入或匯出'
      persistence -> audit '使用共用規則'
    }
    caseData = store '案件資料庫與中繼資料' {
      technology 'SQLite 或 DuckDB · project.json'
      description '案件使用選定的本機引擎。大量資料留在資料庫；畫面取得摘要或有界分頁。'
      link ../evidence.html#architecture '案件資料與組裝'
    }
    desktop.persistence -> caseData '讀寫案件與衍生結果'
  }
  auditor -> jet.desktop.ui '操作'
  inputs -> jet.desktop.fileio '讀取資料'
  jet.desktop.fileio -> reports '發布檔案'
  reports -> auditor '檢視與使用'

  filterSlice = component '篩選儲存的程式切片' {
    description '以下是同一桌面程式中的類別角色，用來閱讀這個情境。不是額外部署的系統。'
    ui = component 'JetApi'
    dispatch = component 'ActionDispatcher'
    handler = component 'FilterScenarioSaveHandler'
    batch = component 'FilterScenarioBatchWriter'
    program = component 'JetAuditProgram'
    facts = component 'FilterFactsPort'
    commit = component 'LocalFilterCommitRepository'
    definitions = component 'LocalFilterScenarioStore'
    db = store '案件資料庫'
    ui -> dispatch 'filter.scenario.save'
    dispatch -> handler '依註冊呼叫 HandleAsync'
    handler -> batch 'Load、PlanSave、Publish'
    batch -> program 'Plan 與 Finalize'
    batch -> facts 'IFilterFactsPort'
    facts -> commit 'IFilterCommitRepository'
    batch -> definitions '仍有不合格情境時'
    commit -> db '定義與命中同一交易'
    definitions -> db '只存定義並清除命中'
  }
}
views {
  view index {
    title 'JET 系統情境與資料往來'
    description 'agent 首次建模。以固定快照為依據；不代表正式部署驗收。'
    include auditor, inputs, jet, reports
    autoLayout LeftRight
  }
  view containers of jet {
    title 'JET 容器與本機資料'
    description '桌面應用程式及其資料儲存。程式分層沒有被誤畫成多個服務。'
    include auditor, inputs, jet.desktop, jet.caseData, reports
    autoLayout LeftRight
  }
  view components of jet.desktop {
    title '桌面程式內部責任'
    description '關係表示責任與已核對的呼叫方向；不是執行時間紀錄。'
    include jet.desktop.*, jet.caseData, inputs, reports
    style * { size small; textSize large }
    autoLayout TopBottom 40 80
  }
  view filterComponents of filterSlice {
    title '篩選情境儲存：類別協作'
    description '介面到實作的選擇另由 AppCompositionRoot 核對；這份切片採 SQLite 或 DuckDB 的 Local 路徑。'
    link ../archify/filter-types/filter-types.html '詳細類別與介面圖'
    link ../evidence.html#filter-save '來源與工具對照'
    include filterSlice.*
    style * { size small }
    autoLayout TopBottom 40 80
  }
  dynamic view filterSave {
    title '篩選情境儲存：成功路徑'
    description '整批情境都合格的靜態流程。例外和未合格分支請看 Archify 業務流程圖。本次沒有執行業務測試。'
    link ../archify/filter-save/filter-save.html '包含分支的業務流程'
    filterSlice.ui -> filterSlice.dispatch 'filter.scenario.save'
    filterSlice.dispatch -> filterSlice.handler '依 action 註冊派送'
    filterSlice.handler -> filterSlice.batch '讀取、檢查與規劃'
    filterSlice.batch -> filterSlice.program 'Plan(FilterRequest)'
    filterSlice.batch -> filterSlice.facts 'IFilterFactsPort.ExecuteAsync'
    filterSlice.facts -> filterSlice.commit 'IFilterCommitRepository.CommitAsync'
    filterSlice.commit -> filterSlice.db '同一交易發布定義與命中'
    filterSlice.batch -> filterSlice.program 'Finalize(FilterPlan, FilterFacts)'
    style * { size small }
    autoLayout TopBottom 40 80
  }
  deployment view localRuntime {
    title '本機執行配置'
    description '一般權限的 Windows 工作站；SQL Server 企業部署不在本次範圍。實際安裝包與公司環境檢查仍待正式部署階段確認。'
    include *
  }
}
deployment {
  workstation local 'Windows 工作站' {
    description '公司環境不能依賴外部 AI。這些文件產生工具只用於開發。'
    instanceOf jet.desktop
    folder caseFolder '使用者可寫入的案件目錄' {
      instanceOf jet.caseData
    }
    instanceOf inputs
    instanceOf reports
  }
}
