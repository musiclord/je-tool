{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "審計計算、畫面查詢與底稿資料",
    "subtitle": "計算留在資料庫；畫面只取摘要與分頁，正式底稿由寫出器分頁串流讀取明細",
    "locale": "zh-TW",
    "output": "archify/audit-dataflow/audit-dataflow.html",
    "quality_profile": "showcase",
    "legend": {
      "mode": "auto",
      "entries": {
        "emphasis": {
          "label": "資料庫內以 SQL 集合式處理"
        },
        "default": {
          "label": "經 JET 程序分頁串流"
        },
        "dashed": {
          "label": "只傳摘要、定義或有界分頁"
        }
      }
    }
  },
  "stages": [
    {
      "label": "資料庫輸入"
    },
    {
      "label": "集合式計算"
    },
    {
      "label": "已保存結果"
    },
    {
      "label": "使用方式"
    }
  ],
  "nodes": [
    {
      "id": "population",
      "type": "database",
      "stage": 0,
      "row": 0,
      "label": "GL 與 TB",
      "sublabel": "標準化資料表"
    },
    {
      "id": "conditions",
      "type": "database",
      "stage": 0,
      "row": 2,
      "label": "情境定義",
      "sublabel": "config_filter_scenario"
    },
    {
      "id": "validation",
      "type": "backend",
      "stage": 1,
      "row": 0,
      "label": "驗證與預篩選",
      "sublabel": "validate.run、prescreen.run"
    },
    {
      "id": "filter",
      "type": "backend",
      "stage": 1,
      "row": 2,
      "label": "進階篩選",
      "sublabel": "條件樹轉成 SQL"
    },
    {
      "id": "summary",
      "type": "database",
      "stage": 2,
      "row": 0,
      "label": "執行摘要",
      "sublabel": "result_rule_run"
    },
    {
      "id": "hits",
      "type": "database",
      "stage": 2,
      "row": 2,
      "label": "命中分錄",
      "sublabel": "result_filter_run"
    },
    {
      "id": "screen",
      "type": "frontend",
      "stage": 3,
      "row": 0,
      "label": "畫面查詢",
      "sublabel": "摘要與有界分頁"
    },
    {
      "id": "workbook",
      "type": "external",
      "stage": 3,
      "row": 2,
      "label": "正式底稿",
      "sublabel": "WorkpaperWriter"
    }
  ],
  "flows": [
    {
      "id": "population_validation",
      "from": "population",
      "to": "validation",
      "label": "計數與彙總",
      "variant": "emphasis"
    },
    {
      "id": "validation_summary",
      "from": "validation",
      "to": "summary",
      "label": "摘要 JSON",
      "variant": "dashed"
    },
    {
      "id": "conditions_filter",
      "from": "conditions",
      "to": "filter",
      "label": "條件定義",
      "variant": "dashed"
    },
    {
      "id": "population_filter",
      "from": "population",
      "to": "filter",
      "label": "測試母體",
      "variant": "emphasis"
    },
    {
      "id": "filter_hits",
      "from": "filter",
      "to": "hits",
      "label": "情境位置與分錄 ID",
      "variant": "emphasis"
    },
    {
      "id": "summary_screen",
      "from": "summary",
      "to": "screen",
      "label": "結果摘要",
      "variant": "dashed"
    },
    {
      "id": "hits_screen",
      "from": "hits",
      "to": "screen",
      "label": "命中分頁",
      "variant": "dashed"
    },
    {
      "id": "hits_workbook",
      "from": "hits",
      "to": "workbook",
      "label": "選取情境的命中"
    },
    {
      "id": "population_workbook",
      "from": "population",
      "to": "workbook",
      "label": "母體明細"
    },
    {
      "id": "summary_workbook",
      "from": "summary",
      "to": "workbook",
      "label": "驗證結果",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "計算在哪裡發生",
      "items": [
        "驗證與預篩選用 SQL 在 target_gl_entry 上計數與彙總，回到 JET 的只有摘要，存成 result_rule_run 的摘要 JSON。",
        "進階篩選把條件樹轉成 SQL，以 INSERT 搭配 SELECT 直接在資料庫寫入命中的情境位置與分錄 ID。",
        "畫面只取摘要與有界分頁，不把整批分錄送進前端或 session。"
      ]
    },
    {
      "dot": "amber",
      "title": "正式底稿讀什麼",
      "items": [
        "WorkpaperPlanningFactsPort 只讀有界事實：差異與不平是否各有第一列、情境筆數與目標欄位定義。",
        "WorkpaperWriter 依計畫用分頁讀取器串流取得完整明細，邊讀邊寫入工作簿。",
        "底稿另讀欄位定義、配對與範本；圖只畫主要審計資料，執行先後與例外看底稿的循序圖。"
      ]
    },
    {
      "dot": "slate",
      "title": "讀圖範圍與來源",
      "items": [
        "這是固定快照的靜態整理，畫 SQLite 或 DuckDB 的 Local 組裝；本次沒有執行驗證、篩選或匯出。",
        "LocalValidationRunRepository.cs 第 175–372 行；LocalPrescreenRunRepository.cs 第 12、232–345 行；LocalRuleRunStore.cs 第 27–28 行。",
        "FilterRunHitInsertSql.cs 第 13 行；WorkpaperPlanningFactsPort.cs 第 17–60 行。"
      ]
    }
  ]
}
