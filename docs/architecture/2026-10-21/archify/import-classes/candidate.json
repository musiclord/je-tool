    "title": "TB 匯入的類別與介面",
    "subtitle": "匯入處理器只依賴介面；Local 組裝建立的實作才實際讀檔、寫資料庫與寫案件檔",
    "locale": "zh-TW",
    "output": "archify/import-classes/import-classes.html",
    "quality_profile": "showcase",
    "legend": {
      "mode": "auto",
      "entries": {
        "dependency": { "label": "依賴：呼叫或建立，線上寫方法" },
        "realization": { "label": "實作介面" },
        "inheritance": { "label": "繼承" }
      }
    }
  },
  "layout": { "mode": "grid", "typeW": 240, "typeMaxW": 300, "gapX": 100, "gapY": 95 },
  "types": [
    { "id": "tb", "label": "ImportTbFromFileHandler", "kind": "class", "row": 0, "col": 0, "sublabel": "import.tb.fromFile", "attributes": [{ "name": "Action", "type": "string" }] },
    { "id": "base", "label": "ImportFromFileHandler", "kind": "abstract", "row": 0, "col": 1, "sublabel": "GL 與 TB 共用流程", "methods": [{ "name": "HandleAsync" }] },
    { "id": "program", "label": "JetAuditProgram", "kind": "class", "row": 0, "col": 2, "sublabel": "建立與收斂匯入計畫", "methods": [{ "name": "Plan", "static": true }, { "name": "Finalize", "static": true }] },
    { "id": "readerContract", "label": "ITabularFileReader", "kind": "interface", "row": 1, "col": 0, "sublabel": "讀標頭與資料列", "methods": [{ "name": "ReadColumnsAsync" }, { "name": "ReadRowsAsync" }] },
    { "id": "intakeContract", "label": "IIntakeFactsPort", "kind": "interface", "row": 1, "col": 1, "sublabel": "執行匯入計畫", "methods": [{ "name": "ExecuteAsync" }] },
    { "id": "projectContract", "label": "IProjectStore", "kind": "interface", "row": 1, "col": 2, "sublabel": "案件進度檔", "methods": [{ "name": "FindAsync" }, { "name": "SaveAsync" }] },
    { "id": "reader", "label": "CompositeTabularFileReader", "kind": "class", "row": 2, "col": 0, "sublabel": "依副檔名交給四種讀取器", "methods": [] },
    { "id": "intake", "label": "IntakeFactsPort", "kind": "class", "row": 2, "col": 1, "sublabel": "依計畫取代或追加", "methods": [{ "name": "ExecuteAsync" }] },
    { "id": "project", "label": "JsonFileProjectStore", "kind": "class", "row": 2, "col": 2, "sublabel": "project.json", "methods": [] },
    { "id": "importContract", "label": "IImportRepository", "kind": "interface", "row": 3, "col": 1, "sublabel": "批次與原始列", "methods": [{ "name": "GetLatestBatchAsync" }, { "name": "ReplaceBatchAsync" }] },
    { "id": "localImport", "label": "LocalImportRepository", "kind": "class", "row": 4, "col": 1, "sublabel": "SQLite 與 DuckDB 共用", "methods": [{ "name": "ReplaceBatchAsync" }] },
    { "id": "root", "label": "AppCompositionRoot", "kind": "class", "row": 4, "col": 0, "sublabel": "建立 Local 組裝", "methods": [{ "name": "CreateLocalProjectRepositories", "static": true }] }
  ],
  "relationships": [
    { "id": "tb_base", "from": "tb", "to": "base", "kind": "inheritance" },
    { "id": "base_program", "from": "base", "to": "program", "kind": "dependency", "label": "Plan、Finalize" },
    { "id": "base_reader", "from": "base", "to": "readerContract", "kind": "dependency", "label": "讀標頭與資料列" },
    { "id": "base_intake", "from": "base", "to": "intakeContract", "kind": "dependency", "label": "ExecuteAsync" },
    { "id": "base_project", "from": "base", "to": "projectContract", "kind": "dependency", "label": "FindAsync、SaveAsync" },
    { "id": "base_import", "from": "base", "to": "importContract", "kind": "dependency", "label": "GetLatestBatchAsync" },
    { "id": "reader_contract", "from": "reader", "to": "readerContract", "kind": "realization" },
    { "id": "intake_contract", "from": "intake", "to": "intakeContract", "kind": "realization" },
    { "id": "project_contract", "from": "project", "to": "projectContract", "kind": "realization" },
    { "id": "intake_import", "from": "intake", "to": "importContract", "kind": "dependency", "label": "ReplaceBatchAsync" },
    { "id": "local_import", "from": "localImport", "to": "importContract", "kind": "realization" },
    { "id": "root_local", "from": "root", "to": "localImport", "kind": "dependency", "label": "建立" },
    { "id": "root_intake", "from": "root", "to": "intake", "kind": "dependency", "label": "建立" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "怎麼分辨編譯時目標與實際類別",
      "items": [
        "ImportFromFileHandler 的依賴線都指向介面，Roslyn 只確定呼叫的是介面方法。",
        "Local 組裝由 AppCompositionRoot.CreateLocalProjectRepositories 建立 LocalImportRepository，再把它傳給新建的 IntakeFactsPort。",
        "CompositeTabularFileReader 與 JsonFileProjectStore 由 CreateRuntimeCore 建立，不分資料庫。這些都是靜態證據，沒有執行期觀察。"
      ]
    },
    {
      "dot": "violet",
      "title": "這張圖省略了什麼",
      "items": [
        "留痕介面 IProjectAuditLog 在 Local 組裝是包住 LocalProjectAuditLog 的 BestEffortProjectAuditLog，見 TB 匯入循序圖。",
        "CompositeTabularFileReader 內部再交給 OpenXmlSaxTableReader、CsvTableReader、BinaryExcelTableReader 與 AccessTableReader。",
        "IntakeFactsPort 追加匯入時呼叫 AppendToBatchAsync；SQL Server 組裝另有 SqlServerImportRepository，開發暫緩。"
      ]
    },
    {
      "dot": "slate",
      "title": "來源",
      "items": [
        "ImportFromFileHandler.cs 第 15、48、59–62、97、131、152、158、390–392、480 行；IntakeFactsPort.cs 第 10–24 行。",
        "LocalImportRepository.cs 第 17 行；CompositeTabularFileReader.cs 第 10 行；JsonFileProjectStore.cs 第 9 行；AppCompositionRoot.cs 第 122、264 行；AppCompositionRoot.Repositories.cs 第 46、118 行。"
      ]
    }
  ]
}
