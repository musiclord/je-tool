  "cards": [
    {
      "dot": "cyan",
      "title": "編譯時與執行時各知道什麼",
      "items": [
        "ActionDispatcher 只呼叫 IApplicationActionHandler.HandleAsync，Roslyn 標成介面呼叫。",
        "AppCompositionRoot.CreateRuntimeCore 建立所有 handler 並傳給 ActionDispatcher；執行時依畫面送來的 action 字串，對照各 handler 的 Action 屬性挑出一個。",
        "圖上三個實作只是本輪各圖會用到的 handler，不是完整清單。"
      ]
    },
    {
      "dot": "violet",
      "title": "派送前的判斷",
      "items": [
        "ActionExecutionPolicy 決定 action 是否互斥、是否在背景執行；互斥的變更型作業要先由 ActionExecutionGate 取得執行權，已有作業時直接回錯誤，不排隊。",
        "JetWebMessageBridge 以 RequestCancellationRegistry.RunAsync 包住派送，畫面可依 requestId 取消。",
        "JavaScript 端的 JetApi 不在 C# 型別裡，圖中沒有畫；WebMessage 這一段見循序圖。"
      ]
    },
    {
      "dot": "slate",
      "title": "來源",
      "items": [
        "Form1.cs 第 496–497 行；JetWebMessageBridge.cs 第 54–56 行；ActionDispatcher.cs 第 47、88–111、161 行。",
        "AppCompositionRoot.cs 第 357、376、395、446 行；ActionExecutionPolicy.cs 第 32–68 行；ImportFromFileHandler.cs 第 15、480 行。"
      ]
    }
  ]
