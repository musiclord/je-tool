        "inheritance": { "label": "繼承" }
      }
    }
  },
  "layout": { "mode": "grid", "typeW": 240, "typeMaxW": 300, "gapX": 100, "gapY": 95 },
  "types": [
    { "id": "form", "label": "Form1", "kind": "class", "row": 0, "col": 0, "sublabel": "WinForms 主視窗", "methods": [] },
    { "id": "bridge", "label": "JetWebMessageBridge", "kind": "class", "row": 0, "col": 1, "sublabel": "接收 WebMessage", "methods": [{ "name": "Attach" }, { "name": "OnWebMessageReceived", "visibility": "private" }] },
    { "id": "registry", "label": "RequestCancellationRegistry", "kind": "class", "row": 0, "col": 2, "sublabel": "requestId 對應取消權杖", "methods": [{ "name": "RunAsync" }] },
    { "id": "root", "label": "AppCompositionRoot", "kind": "class", "row": 1, "col": 0, "sublabel": "建立執行時物件", "methods": [{ "name": "CreateRuntimeCore", "static": true }] },
    { "id": "dispatcher", "label": "ActionDispatcher", "kind": "class", "row": 1, "col": 1, "sublabel": "依 action 字串查 handler", "methods": [{ "name": "DispatchAsync" }] },
