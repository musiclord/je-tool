    { "id": "policy", "label": "ActionExecutionPolicy", "kind": "class", "row": 1, "col": 3, "sublabel": "static，action 分類", "methods": [{ "name": "IsExclusive", "static": true }, { "name": "RunsInBackground", "static": true }] },
