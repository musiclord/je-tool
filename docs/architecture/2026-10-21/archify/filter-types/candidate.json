  "cards": [
    {
      "dot": "cyan",
      "title": "怎麼分辨編譯時目標與實際類別",
      "items": [
        "依賴線指向介面時，Roslyn 只確定呼叫的是介面方法，例如 IFilterFactsPort.ExecuteAsync。",
        "實際類別要看 AppCompositionRoot 的「建立」線：Local 組裝建立 FilterFactsPort、LocalFilterCommitRepository 與 LocalFilterScenarioStore，再注入使用端。",
        "這些都是靜態證據，沒有執行期觀察；本圖不表示每次儲存都會走到每一條線。"
      ]
    },
    {
      "dot": "violet",
      "title": "這張圖省略了什麼",
      "items": [
        "方法區只列這條流程用到的方法；完整簽章在證據頁的類別簽章資料。",
        "SQL Server 組裝另有 SqlServerFilterCommitRepository 與 SqlServerFilterScenarioStore，開發暫緩，本圖不畫。",
        "FilterScenarioBatchWriter 另呼叫 MappingCommitShared.AdvanceStepAsync 推進步驟，見業務流程圖。"
      ]
    },
    {
      "dot": "slate",
      "title": "來源",
      "items": [
        "FilterScenarioHandlers.cs 第 12、39–43 行；FilterScenarioBatchWriter.cs 第 229–246 行；FilterFactsPort.cs 第 10、48 行。",
        "LocalFilterCommitRepository.cs 第 13 行；LocalFilterScenarioStore.cs 第 6 行；AppCompositionRoot.Repositories.cs 第 57、61、134 行。"
      ]
    }
  ]
