  "cards": [
    {
      "dot": "cyan",
      "title": "責任邊界",
      "items": [
        "前端只做操作與呈現，不做審計裁定",
        "Bridge 只傳 request、response 與非權威 event",
        "原生檔案對話框也走 host.* action：handler 經 IHostShell 交回 Form1 執行",
        "規則與裁定集中在 Domain 與 AuditCore"
      ]
    },
    {
      "dot": "emerald",
      "title": "資料庫分流",
      "items": [
        "project.json 的 databaseProvider 在建案時選定，之後不變",
        "sqlite 與 duckdb 共用同一套 Local* repository；sqlServer 另有實作",
        "三種 provider 在相同輸入下必須得到相同業務結果"
      ]
    },
    {
      "dot": "amber",
      "title": "大量資料與正式產物",
      "items": [
        "匯入以 OpenXmlSaxTableReader 與 CsvTableReader 串流寫入 staging",
        "篩選、彙總與分頁留在資料庫；前端只收摘要與有界頁面",
        "六種正式報告先暫存在案件資料夾，完整後原子發布並寫入 report-artifacts.json"
      ]
    }
  ]
