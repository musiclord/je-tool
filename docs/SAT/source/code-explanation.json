  "items": [
    {
      "title": "完整性測試",
      "path": "src/JET/JET/AuditCore/ValidationProcedures.cs",
      "start": 123,
      "explanation": "GL 和 TB 各自依科目加總，再保留兩邊出現的科目。缺少的一邊以零比較。",
      "review": "R02",
      "example": "合成科目 A 的 GL 淨額及 TB 本期變動同為 70，應沒有差異。",
      "code": [
        "    public static string CompletenessDiffCteFor(string schemaPrefix) =>",
        "        $$\"\"\"",
        "        WITH gl_by_account AS (",
        "            SELECT account_number, MAX(account_name) AS account_name, SUM(amount_scaled) AS s",
        "            FROM {{schemaPrefix}}gl",
        "            WHERE {{GlExcludedPopulation.SqlPredicate()}}",
        "            GROUP BY account_number",
        "        ),",
        "        tb_by_account AS (",
        "            SELECT account_number, MAX(account_name) AS account_name, SUM(change_amount_scaled) AS s",
        "            FROM {{schemaPrefix}}tb",
        "            GROUP BY account_number",
        "        ),",
        "        diff AS (",
        "            SELECT t.account_number            AS account_number,",
        "                   COALESCE(t.account_name, g.account_name) AS account_name,",
        "                   t.s                        AS tb_s,",
        "                   COALESCE(g.s, 0)           AS gl_s,",
        "                   0                          AS not_in_tb",
        "            FROM tb_by_account t",
        "            LEFT JOIN gl_by_account g ON g.account_number = t.account_number",
        "            UNION ALL",
        "            SELECT g.account_number, g.account_name, 0, g.s, 1",
        "            FROM gl_by_account g",
        "            LEFT JOIN tb_by_account t ON t.account_number = g.account_number",
        "            WHERE t.account_number IS NULL",
        "        )",
        "        \"\"\";"
      ]
    },
    {
      "title": "借貸不平",
      "path": "src/JET/JET/AuditCore/ValidationProcedures.cs",
      "start": 44,
      "explanation": "只取納入測試且有傳票號碼的分錄，依號碼彙總淨額，留下不為零的傳票。",
      "review": "R03",
      "example": "借方 100、貸方 90：淨額 10，應列入。",
      "code": [
        "    public static string UnbalancedCore(string schemaPrefix = \"\", string extraFilter = \"\") =>",
        "        $\"FROM {schemaPrefix}gl WHERE {GlExcludedPopulation.SqlPredicate()} AND voucher_number IS NOT NULL{extraFilter} \" +",
        "        \"GROUP BY voucher_number HAVING SUM(amount_scaled) <> 0\";"
      ]
    },
    {
      "title": "沒有試算表",
      "path": "src/JET/JET/AuditCore/AccountComparisonProcedure.cs",
      "start": 65,
      "explanation": "可以比對時使用差異科目數；無法比對時另寫原因，不能把沒有 TB 說成完整性已通過。",
      "review": "R02",
      "example": "未匯入 TB：逐科目比對不適用，其他作業仍可繼續。",
      "code": [
        "    internal static ProcedureVerdict Finalize(",
        "        AccountComparisonPlan plan,",
        "        AccountComparisonFacts facts)",
        "    {",
        "        ArgumentNullException.ThrowIfNull(plan);",
        "        ArgumentNullException.ThrowIfNull(facts);",
        "",
        "        var count = plan.IsApplicable ? facts.DifferenceAccountCount : 0L;",
        "        return plan.Verdict with",
        "        {",
        "            Status = count > 0 ? \"V\" : \"na\",",
        "            Count = count",
        "        };",
        "    }",
        "",
        "    private static ProcedureVerdict CreateVerdict(bool hasTbMapping, bool hasTbImport) => new(",
        "        Definition,",
        "        IsApplicable: hasTbMapping,",
        "        NaReason: hasTbMapping ? null : hasTbImport ? MissingTbMappingReason : MissingTbImportReason);"
      ]
    },
