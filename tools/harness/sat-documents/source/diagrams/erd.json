    { "id": "rules", "label": "Rules and results", "tables": ["account_category", "account_category_path", "account_mapping", "authorized_preparer", "calendar_day", "validation_result", "prescreen_result", "inf_sample", "filter_scenario", "filter_hit", "filter_hit_condition"] },
    { "id": "system", "label": "System records", "tables": ["schema_info", "result_stale_state", "message_log", "operation_log"] }
  ],
  "relations": [
    { "from": "import_batch_source", "to": "import_batch", "label": "batch_id" },
