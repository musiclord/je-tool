    { "from": "pbc_gl", "to": "import_batch", "label": "batch_id" },
    { "from": "pbc_tb", "to": "import_batch", "label": "batch_id" },
    { "from": "gl", "to": "import_batch", "label": "batch_id" },
    { "from": "tb", "to": "import_batch", "label": "batch_id" },
    { "from": "field_mapping_previous", "to": "field_mapping", "label": "dataset_kind", "oneToOne": true, "toOptional": true },
    { "from": "gl_rde_value", "to": "gl", "label": "entry_id" },
    { "from": "gl_rde_value", "to": "gl_rde_field", "label": "field_id" },
    { "from": "account_category_path", "to": "account_category", "label": "ancestor_id, descendant_id" },
    { "from": "account_mapping", "to": "account_category", "label": "category_id", "toOptional": true },
    { "from": "filter_hit", "to": "filter_scenario", "label": "scenario_id" },
    { "from": "filter_hit_condition", "to": "filter_scenario", "label": "scenario_id" },
    { "from": "filter_hit", "to": "gl", "label": "entry_id" },
    { "from": "filter_hit_condition", "to": "gl", "label": "entry_id" },
    { "from": "inf_sample", "to": "gl", "label": "entry_id" }
  ]
