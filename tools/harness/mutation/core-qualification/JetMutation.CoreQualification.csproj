<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Use the exact local tool build and its managed dependencies. No JET
         product project or product test project is referenced or copied. -->
    <Reference Include="$(StrykerCliDirectory)/*.dll">
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
