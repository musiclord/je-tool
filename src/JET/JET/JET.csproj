<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <Configurations>Debug;Release;AgentGuiTest</Configurations>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
    <!-- 發布只產生 win-x64 版本。 -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Agent 專用的真實 WebView2 GUI 測試組態。一般 Debug/F5 與 Release/publish 都不編入此入口。
       這個組態帶測試接點與遠端偵錯，不能發布。唯一的例外是驗證框架的 Gui 路線帶 JetAgentGuiOwnedBundle=true，
       照 FolderProfile 打包成單一執行檔，輸出到驗證框架這次執行在 artifacts/harness/runs 底下的資料夾，跑完就刪除（裁定 2026-11-09-03）。 -->
  <PropertyGroup Condition="'$(Configuration)' == 'AgentGuiTest'">
    <DefineConstants>TRACE;JET_AGENT_GUI_TEST</DefineConstants>
    <Optimize>false</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <IsPublishable Condition="'$(JetAgentGuiOwnedBundle)' != 'true'">false</IsPublishable>
  </PropertyGroup>

  <Target Name="RejectAgentGuiTestPublish" BeforeTargets="Publish" Condition="'$(Configuration)' == 'AgentGuiTest' and '$(JetAgentGuiOwnedBundle)' != 'true'">
    <Error Text="AgentGuiTest is an isolated test configuration and cannot be published." />
  </Target>

  <!-- 驗證框架的打包也要在任何檔案複製前確認：輸出在 artifacts/harness/runs 底下，而且是單一執行檔。 -->
  <Target Name="RestrictAgentGuiOwnedBundle" BeforeTargets="PrepareForPublish;Publish" Condition="'$(Configuration)' == 'AgentGuiTest' and '$(JetAgentGuiOwnedBundle)' == 'true'">
    <PropertyGroup>
      <_JetHarnessRunsRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\..\..\artifacts\harness\runs').ToLowerInvariant())</_JetHarnessRunsRoot>
      <_JetOwnedBundleDirectory>$([MSBuild]::NormalizeDirectory('$(PublishDir)').ToLowerInvariant())</_JetOwnedBundleDirectory>
      <_JetOwnedBundleInsideRuns>$(_JetOwnedBundleDirectory.StartsWith('$(_JetHarnessRunsRoot)'))</_JetOwnedBundleInsideRuns>
    </PropertyGroup>
    <Error Condition="'$(_JetOwnedBundleInsideRuns)' != 'True' or '$(_JetOwnedBundleDirectory)' == '$(_JetHarnessRunsRoot)' or '$(PublishSingleFile)' != 'true'"
           Text="AgentGuiTest can only be bundled as a single file by the verification harness, into its own run folder under artifacts/harness/runs." />
  </Target>

  <ItemGroup>
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Templates\AccountMapping.xlsx;Templates\CriteriaSelectionReport.xlsx;Templates\INFReport.xlsx;Templates\PrescreeningReport.xlsx;Templates\ValidationReport.xlsx;Templates\WorkingPaper.xlsx;Templates\Holiday2025TW.xlsx;Templates\MakeUpDay2025TW.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- ClosedXML 僅供 DemoWorkbookWriter(dev-only 寫檔)；匯入讀取走 DocumentFormat.OpenXml SAX -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <!-- 安全覆蓋:MDS 10.0.x 仍傳遞鎖定有漏洞的 SQLitePCLRaw 2.1.11(CVE-2025-6965 / GHSA-2m69-gcr7-jv3q）。
         顯式釘到 3.0.3(內建 SQLite 3.50.4.2;3.0.1 起原生套件改名為 SourceGear.sqlite3,有漏洞的 lib.e_sqlite3 因此離開相依圖)。 -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- 診斷日誌（第三層、dev-only）：M.E.Logging + LoggerMessage 來源產生器 -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JET.Tests" />
  </ItemGroup>

</Project>
