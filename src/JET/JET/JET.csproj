<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <Configurations>Debug;Release</Configurations>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
    <!-- 發布只產生 win-x64 版本。 -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Templates\AccountMapping.xlsx;Templates\CriteriaSelectionReport.xlsx;Templates\INFReport.xlsx;Templates\PrescreeningReport.xlsx;Templates\ValidationReport.xlsx;Templates\WorkingPaper.xlsx;Templates\Holiday2025TW.xlsx;Templates\MakeUpDay2025TW.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- ClosedXML 僅供 DemoWorkbookWriter(dev-only 寫檔)；匯入讀取走 DocumentFormat.OpenXml SAX -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <!-- 直接引用較新的 bundle,取代 Microsoft.Data.Sqlite 間接引用的 2.1.x。原生程式庫改由 SQLite 套件提供,
         版本不得低於 CVE-2025-6965(GHSA-2m69-gcr7-jv3q)建議的 3.50.2;公告列為受影響的
         SQLitePCLRaw.lib.e_sqlite3 因此不在套件還原結果內。 -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- 診斷日誌（第三層、dev-only）：M.E.Logging + LoggerMessage 來源產生器 -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JET.Tests" />
  </ItemGroup>

</Project>
