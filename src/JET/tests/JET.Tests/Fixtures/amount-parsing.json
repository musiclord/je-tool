{
  "description": [
    "前後端共用的金額固定答案。",
    "C# 的 MoneyScalingTests、TypedFieldRuleValidationTests 與前端 frontend-shared-controls 的金額條件測試都讀這一份；一邊改了規則，另一邊的測試就會失敗。",
    "scaled 是金額存放倍率為 moneyScale 時 MoneyScaling.TryParseScaled 的結果，寫成字串，因為超過 JavaScript 能精確表示的整數；null 表示不是有效金額，畫面與後端都寫「金額「原文」不是數字」。",
    "ranges 是金額區間；result 為 ok、reversed（下限金額大於上限金額）、invalidFrom、invalidTo 或 invalidBoth。畫面寫第一個讀不成的值，後端每個讀不成的值各寫一句。",
    "空白不列在這裡：畫面寫「請填好條件值」，匯入時空白當成 0，各有自己的測試。",
    "小數超過 28 位的寫法不列入：後端先依 decimal 的精度捨入，畫面照原文精確計算，結果可能差 1。",
    "看不見的字元用 \\u 跳脫寫出。note 說明這個案例的來由，不影響測試。"
  ],
  "moneyScale": 10000,
  "cases": [
    { "group": "千分位", "raw": "1234", "scaled": "12340000" },
    { "group": "千分位", "raw": "1,234", "scaled": "12340000" },
    { "group": "千分位", "raw": "1,234,567.89", "scaled": "12345678900" },
    { "group": "千分位", "raw": "0012", "scaled": "120000" },
    { "group": "千分位", "raw": "1,234.", "scaled": "12340000" },
    { "group": "千分位", "raw": "12,34", "scaled": null, "note": "千分位每組要剛好 3 位；單一金額的欄位不把逗號拆成兩個值" },
    { "group": "千分位", "raw": "1,2345", "scaled": null },
    { "group": "千分位", "raw": "1,,234", "scaled": null },
    { "group": "千分位", "raw": "1,", "scaled": null },
    { "group": "千分位", "raw": ",123", "scaled": null },
    { "group": "千分位", "raw": "1,234.5,6", "scaled": null },
    { "group": "千分位", "raw": "1 234", "scaled": null },
    { "group": "正負號", "raw": "0", "scaled": "0" },
    { "group": "正負號", "raw": "-1,234.50", "scaled": "-12345000" },
    { "group": "正負號", "raw": "1,234.50-", "scaled": "-12345000" },
    { "group": "正負號", "raw": "1,234.50 -", "scaled": "-12345000", "note": "尾端正負號前面可以有空白" },
    { "group": "正負號", "raw": "+12.50", "scaled": "125000" },
    { "group": "正負號", "raw": "12+", "scaled": "120000" },
    { "group": "正負號", "raw": "-", "scaled": "0", "note": "會計格式的 0" },
    { "group": "正負號", "raw": "- 12", "scaled": null, "note": "開頭正負號後面不能有空白" },
    { "group": "正負號", "raw": "-12-", "scaled": null },
    { "group": "正負號", "raw": "+12-", "scaled": null },
    { "group": "正負號", "raw": "--12", "scaled": null },
    { "group": "正負號", "raw": "−12", "scaled": null, "note": "數學減號 U+2212 不是正負號" },
    { "group": "括號", "raw": "(100)", "scaled": "-1000000", "note": "括號表示負數" },
    { "group": "括號", "raw": "(1,234.50)", "scaled": "-12345000" },
    { "group": "括號", "raw": "(12 )", "scaled": "-120000" },
    { "group": "括號", "raw": "( 12)", "scaled": null },
    { "group": "括號", "raw": "12 )", "scaled": null },
    { "group": "括號", "raw": "(12", "scaled": null },
    { "group": "括號", "raw": "12)", "scaled": null },
    { "group": "括號", "raw": "(-12)", "scaled": null },
    { "group": "括號", "raw": "-(12)", "scaled": null },
    { "group": "括號", "raw": "(12)-", "scaled": null },
    { "group": "空白字元", "raw": " 12 ", "scaled": "120000" },
    { "group": "空白字元", "raw": "\t12\t", "scaled": "120000" },
    { "group": "空白字元", "raw": "　12　", "scaled": "120000", "note": "全形空白" },
    { "group": "空白字元", "raw": " 12", "scaled": "120000", "note": "不換行空白" },
    { "group": "空白字元", "raw": "\u008512", "scaled": "120000", "note": ".NET 去頭尾空白包含 U+0085，JavaScript 的 trim 不含" },
    { "group": "空白字元", "raw": "﻿12", "scaled": null, "note": ".NET 不把 U+FEFF 當空白，JavaScript 的 trim 會去掉" },
    { "group": "小數與進位", "raw": ".5", "scaled": "5000" },
    { "group": "小數與進位", "raw": "5.", "scaled": "50000" },
    { "group": "小數與進位", "raw": "0.00005", "scaled": "1", "note": "剛好一半往遠離零的方向進位" },
    { "group": "小數與進位", "raw": "-0.00005", "scaled": "-1" },
    { "group": "小數與進位", "raw": "0.00004999", "scaled": "0" },
    { "group": "小數與進位", "raw": "-0.00004", "scaled": "0", "note": "放大後是 0，不算負數" },
    { "group": "小數與進位", "raw": "10.00005", "scaled": "100001" },
    { "group": "小數與進位", "raw": "10.00006", "scaled": "100001" },
    { "group": "可存的範圍", "raw": "922337203685477.5807", "scaled": "9223372036854775807" },
    { "group": "可存的範圍", "raw": "-922337203685477.5808", "scaled": "-9223372036854775808" },
    { "group": "可存的範圍", "raw": "922,337,203,685,477.5807", "scaled": "9223372036854775807" },
    { "group": "可存的範圍", "raw": "922337203685477.5808", "scaled": null },
    { "group": "可存的範圍", "raw": "-922337203685477.5809", "scaled": null },
    { "group": "可存的範圍", "raw": "99999999999999999999", "scaled": null },
    { "group": "不收的寫法", "raw": "1e3", "scaled": null },
    { "group": "不收的寫法", "raw": "$12", "scaled": null },
    { "group": "不收的寫法", "raw": "12%", "scaled": null },
    { "group": "不收的寫法", "raw": "１２", "scaled": null, "note": "全形數字" },
    { "group": "不收的寫法", "raw": "12.3.4", "scaled": null },
    { "group": "不收的寫法", "raw": ".", "scaled": null },
    { "group": "不收的寫法", "raw": "not-money", "scaled": null },
    { "group": "不收的寫法", "raw": "12 34", "scaled": null }
  ],
  "ranges": [
    { "from": "12,34", "to": "100", "result": "invalidFrom", "note": "上下限先各自讀成金額；讀不成時寫出不是數字，不比較上下限" },
    { "from": "100", "to": "12,34", "result": "invalidTo" },
    { "from": "12,34", "to": "1,2345", "result": "invalidBoth" },
    { "from": "2", "to": "1", "result": "reversed" },
    { "from": "50", "to": "(1,234.50)", "result": "reversed", "note": "括號是負數" },
    { "from": "(1,234.50)", "to": "50", "result": "ok" },
    { "from": "1,000", "to": "1000", "result": "ok" },
    { "from": "10.00006", "to": "10.00005", "result": "ok", "note": "放大取整後相等，不算下限大於上限" },
    { "from": "-0.00004", "to": "0", "result": "ok" },
    { "from": "922337203685477.5807", "to": "922337203685477.5808", "result": "invalidTo" }
  ]
}
