<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- xUnit1051 newly flags ~1,000 intentional CancellationToken.None calls which are test inputs
         (including cancellation semantics); keep other analyzer warnings active and gate them. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <Configurations>Debug;Release</Configurations>
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="FsCheck.Xunit.v3" Version="3.4.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.CrashDump" Version="2.5.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <PackageReference Include="Microsoft.Testing.Platform" Version="2.5.1" />
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" Version="2.5.1" />
    <!-- 架構依賴方向的機器守衛（LayerDependencyTests）：以 IL 掃描層級 namespace 之間的依賴，
         把「Application 不得依賴 Infrastructure」等架構規則從人工審查升級為 CI 可擋。 -->
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\JET\JET.csproj" />
  </ItemGroup>

</Project>
