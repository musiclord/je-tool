<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- CancellationToken.None 是測試的固定輸入，部分案例專門驗證取消行為。 -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <Configurations>Debug;Release</Configurations>
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="FsCheck.Xunit.v3" Version="3.4.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.CrashDump" Version="2.5.3" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.3" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" />
    <PackageReference Include="Microsoft.Testing.Platform" Version="2.5.3" />
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" Version="2.5.3" />
    <!-- 架構依賴方向的檢查（LayerDependencyTests）：以 IL 掃描層級 namespace 之間的依賴，
         用測試檢查「Application 不得依賴 Infrastructure」等各層之間的依賴方向。 -->
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\JET\JET.csproj" />
  </ItemGroup>

</Project>
